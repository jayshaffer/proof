diff --git a/apps/api/src/__tests__/routes/internal-practices-crud.test.ts b/apps/api/src/__tests__/routes/internal-practices-crud.test.ts
new file mode 100644
index 00000000..54aec897
--- /dev/null
+++ b/apps/api/src/__tests__/routes/internal-practices-crud.test.ts
@@ -0,0 +1,301 @@
+import { clearAllItems, practiceRepository } from "@attribution-service/data";
+import { afterEach, describe, expect, test, vi } from "vitest";
+import { useServerHelper } from "../util";
+
+vi.mock("../../config");
+
+const AUTH_HEADER = { authorization: "Bearer valid-test-key" };
+
+const BASE_BODY = {
+  id: "ACCT-001",
+  name: "Smith Family Practice",
+  status: "SOLD" as const,
+  accountManager: "Jordan Lee",
+  practiceEmail: "front-desk@smith.example",
+};
+
+describe("internal practices CRUD", () => {
+  const serverHelper = useServerHelper();
+
+  afterEach(async () => {
+    await clearAllItems();
+  });
+
+  const post = (payload: unknown) =>
+    serverHelper.getServer().inject({
+      method: "POST",
+      url: "/internal/practices",
+      headers: AUTH_HEADER,
+      payload,
+    });
+
+  const get = (url: string) =>
+    serverHelper.getServer().inject({ method: "GET", url, headers: AUTH_HEADER });
+
+  const patch = (id: string, payload: unknown) =>
+    serverHelper.getServer().inject({
+      method: "PATCH",
+      url: `/internal/practices/${id}`,
+      headers: AUTH_HEADER,
+      payload,
+    });
+
+  const del = (url: string) =>
+    serverHelper.getServer().inject({ method: "DELETE", url, headers: AUTH_HEADER });
+
+  describe("POST /internal/practices", () => {
+    test("valid body returns 201 with the stored record and server timestamps", async () => {
+      const res = await post(BASE_BODY);
+
+      expect(res.statusCode).toBe(201);
+      expect(res.json()).toMatchObject(BASE_BODY);
+      expect(typeof res.json().createdAt).toBe("string");
+      expect(typeof res.json().updatedAt).toBe("string");
+    });
+
+    test("duplicate id returns 409 ConflictError and leaves the record unmodified", async () => {
+      await post(BASE_BODY);
+
+      const res = await post({ ...BASE_BODY, name: "Impostor Practice" });
+
+      expect(res.statusCode).toBe(409);
+      expect(res.json()).toMatchObject({ errorType: "ConflictError" });
+
+      const stored = await get("/internal/practices/ACCT-001");
+      expect(stored.json().name).toBe("Smith Family Practice");
+    });
+
+    test("missing name returns 422", async () => {
+      const { name, ...withoutName } = BASE_BODY;
+
+      const res = await post(withoutName);
+
+      expect(res.statusCode).toBe(422);
+      expect(res.json()).toMatchObject({ errorType: "UnprocessableContentError" });
+    });
+
+    test("status outside the enum returns 422", async () => {
+      const res = await post({ ...BASE_BODY, status: "NOT_A_STATUS" });
+
+      expect(res.statusCode).toBe(422);
+    });
+
+    test("supplying server-managed createdAt returns 422", async () => {
+      const res = await post({ ...BASE_BODY, createdAt: "2020-01-01T00:00:00.000Z" });
+
+      expect(res.statusCode).toBe(422);
+    });
+
+    test("omitted optional fields are absent on read, not null", async () => {
+      await post({ id: "p-minimal", name: "Minimal", status: "SOLD" });
+
+      const body = (await get("/internal/practices/p-minimal")).json();
+
+      expect(body).not.toHaveProperty("accountManager");
+      expect(body).not.toHaveProperty("practiceEmail");
+      expect(body).not.toHaveProperty("lastReferralDate");
+    });
+  });
+
+  describe("GET /internal/practices/{practiceId}", () => {
+    test("existing id returns 200 with every stored attribute", async () => {
+      await post({ ...BASE_BODY, lastReferralDate: "2026-05-15" });
+
+      const res = await get("/internal/practices/ACCT-001");
+
+      expect(res.statusCode).toBe(200);
+      expect(res.json()).toMatchObject({
+        ...BASE_BODY,
+        lastReferralDate: "2026-05-15",
+      });
+    });
+
+    test("unknown id returns 404 NotFoundError", async () => {
+      const res = await get("/internal/practices/does-not-exist");
+
+      expect(res.statusCode).toBe(404);
+      expect(res.json()).toMatchObject({ errorType: "NotFoundError" });
+    });
+  });
+
+  describe("GET /internal/practices", () => {
+    test("no filter returns a page of practices", async () => {
+      await post(BASE_BODY);
+      await post({ id: "ACCT-002", name: "Jones Practice", status: "CHURNED" });
+
+      const res = await get("/internal/practices");
+
+      expect(res.statusCode).toBe(200);
+      expect(res.json().practices).toHaveLength(2);
+    });
+
+    test("filters by name, status, and accountManager", async () => {
+      await post(BASE_BODY);
+      await post({
+        id: "ACCT-002",
+        name: "Jones Practice",
+        status: "CHURNED",
+        accountManager: "Casey Kim",
+      });
+
+      const byName = await get("/internal/practices?name=Jones%20Practice");
+      expect(byName.json().practices.map((p: { id: string }) => p.id)).toEqual(["ACCT-002"]);
+
+      const byStatus = await get("/internal/practices?status=SOLD");
+      expect(byStatus.json().practices.map((p: { id: string }) => p.id)).toEqual(["ACCT-001"]);
+
+      const byAm = await get("/internal/practices?accountManager=Casey%20Kim");
+      expect(byAm.json().practices.map((p: { id: string }) => p.id)).toEqual(["ACCT-002"]);
+    });
+
+    test("name lookup is case-insensitive because the GSI2 key is upper-cased", async () => {
+      await post(BASE_BODY);
+
+      const res = await get("/internal/practices?name=smith%20family%20practice");
+
+      expect(res.json().practices.map((p: { id: string }) => p.id)).toEqual(["ACCT-001"]);
+    });
+
+    test("accountManager lookup is case-insensitive", async () => {
+      await post(BASE_BODY);
+
+      const res = await get("/internal/practices?accountManager=jordan%20lee");
+
+      expect(res.json().practices.map((p: { id: string }) => p.id)).toEqual(["ACCT-001"]);
+    });
+
+    test("limit outside 1-100 returns 422", async () => {
+      expect((await get("/internal/practices?limit=0")).statusCode).toBe(422);
+      expect((await get("/internal/practices?limit=101")).statusCode).toBe(422);
+    });
+
+    test("cursor replay returns the next page without repeats or gaps", async () => {
+      for (const id of ["p1", "p2", "p3"]) {
+        await post({ id, name: `Practice ${id}`, status: "SOLD" });
+      }
+
+      const first = await get("/internal/practices?limit=2");
+      expect(first.json().practices).toHaveLength(2);
+      expect(first.json().nextCursor).toBeDefined();
+
+      const cursor = encodeURIComponent(first.json().nextCursor);
+      const second = await get(`/internal/practices?limit=2&cursor=${cursor}`);
+
+      const firstIds = first.json().practices.map((p: { id: string }) => p.id);
+      const secondIds = second.json().practices.map((p: { id: string }) => p.id);
+
+      expect(secondIds).not.toEqual(expect.arrayContaining(firstIds));
+      expect([...firstIds, ...secondIds].sort()).toEqual(["p1", "p2", "p3"]);
+    });
+  });
+
+  describe("PATCH /internal/practices/{practiceId}", () => {
+    test("partial body returns 200 and preserves untouched fields", async () => {
+      await post({ ...BASE_BODY, lastReferralDate: "2026-05-15" });
+
+      const res = await patch("ACCT-001", { status: "CHURNED" });
+
+      expect(res.statusCode).toBe(200);
+      expect(res.json()).toMatchObject({
+        id: "ACCT-001",
+        name: "Smith Family Practice",
+        status: "CHURNED",
+        accountManager: "Jordan Lee",
+        practiceEmail: "front-desk@smith.example",
+        lastReferralDate: "2026-05-15",
+      });
+    });
+
+    test("unknown id returns 404 and does not create the record", async () => {
+      const res = await patch("does-not-exist", { name: "Ghost" });
+
+      expect(res.statusCode).toBe(404);
+      expect(await practiceRepository.getPractice("does-not-exist")).toBeNull();
+    });
+
+    test("body containing id returns 422 — id is immutable", async () => {
+      await post(BASE_BODY);
+
+      const res = await patch("ACCT-001", { id: "ACCT-999", name: "Renamed" });
+
+      expect(res.statusCode).toBe(422);
+    });
+
+    test("null clears an optional field so it is absent on re-read", async () => {
+      await post(BASE_BODY);
+
+      const res = await patch("ACCT-001", { practiceEmail: null });
+
+      expect(res.statusCode).toBe(200);
+      expect(res.json()).not.toHaveProperty("practiceEmail");
+      expect((await get("/internal/practices/ACCT-001")).json()).not.toHaveProperty(
+        "practiceEmail",
+      );
+    });
+
+    test("clearing accountManager removes it from the account-manager lookup", async () => {
+      await post(BASE_BODY);
+
+      await patch("ACCT-001", { accountManager: null });
+
+      const res = await get("/internal/practices?accountManager=Jordan%20Lee");
+      expect(res.json().practices).toEqual([]);
+    });
+
+    test("empty body returns 422 rather than issuing a no-op write", async () => {
+      await post(BASE_BODY);
+
+      const res = await patch("ACCT-001", {});
+
+      expect(res.statusCode).toBe(422);
+    });
+
+    test("advances updatedAt and leaves createdAt unchanged", async () => {
+      const created = (await post(BASE_BODY)).json();
+      await new Promise((resolve) => setTimeout(resolve, 25));
+
+      const patched = (await patch("ACCT-001", { name: "Renamed" })).json();
+
+      expect(patched.createdAt).toBe(created.createdAt);
+      expect(new Date(patched.updatedAt).getTime()).toBeGreaterThan(
+        new Date(created.updatedAt).getTime(),
+      );
+    });
+  });
+
+  describe("DELETE /internal/practices/{practiceId}", () => {
+    test("existing id returns 204 and removes the record", async () => {
+      await post(BASE_BODY);
+
+      const res = await del("/internal/practices/ACCT-001");
+
+      expect(res.statusCode).toBe(204);
+      expect((await get("/internal/practices/ACCT-001")).statusCode).toBe(404);
+    });
+
+    test("unknown id returns 404", async () => {
+      const res = await del("/internal/practices/does-not-exist");
+
+      expect(res.statusCode).toBe(404);
+    });
+
+    test("deleting one practice leaves the others intact", async () => {
+      await post(BASE_BODY);
+      await post({ id: "ACCT-002", name: "Jones Practice", status: "SOLD" });
+
+      await del("/internal/practices/ACCT-001");
+
+      expect((await get("/internal/practices/ACCT-002")).statusCode).toBe(200);
+    });
+
+    test("delete-all keeps its existing 204 behavior", async () => {
+      await post(BASE_BODY);
+      await post({ id: "ACCT-002", name: "Jones Practice", status: "SOLD" });
+
+      const res = await del("/internal/practices");
+
+      expect(res.statusCode).toBe(204);
+      expect((await get("/internal/practices")).json().practices).toEqual([]);
+    });
+  });
+});
