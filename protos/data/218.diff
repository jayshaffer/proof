+import { beforeAll, describe, expect, test, vi } from "vitest";
+import { useServerHelper } from "../util";
+
+vi.mock("../../config");
+vi.mock("../../service/pcp-referrals-service", () => ({
+  deleteAllReferrals: vi.fn().mockResolvedValue(0),
+}));
+vi.mock("../../service/practice-service", () => ({
+  deleteAllPractices: vi.fn().mockResolvedValue(0),
+  ingestPractices: vi.fn().mockResolvedValue({ upserted: 0, errors: 0 }),
+}));
+
+const VALID_KEY = "Bearer valid-test-key";
+
+const HTTP_METHODS = new Set(["get", "put", "post", "delete", "options", "head", "patch", "trace"]);
+
+type Operation = { method: string; url: string };
+
+/**
+ * Derived from the served spec rather than hardcoded, so an operation added in a
+ * later phase is covered by this matrix the moment it is declared.
+ */
+const authenticated: Operation[] = [];
+const preflight: Operation[] = [];
+
+describe("internal auth matrix", () => {
+  const serverHelper = useServerHelper();
+
+  beforeAll(async () => {
+    const res = await serverHelper
+      .getServer()
+      .inject({ method: "GET", url: "/internal-documentation/json" });
+    const spec = res.json() as {
+      security?: Record<string, string[]>[];
+      paths?: Record<string, Record<string, { security?: Record<string, string[]>[] }>>;
+    };
+    const specWideSecurity = spec.security ?? [];
+
+    for (const [path, methods] of Object.entries(spec.paths ?? {})) {
+      for (const [method, operation] of Object.entries(methods)) {
+        // A path item may carry a shared `parameters` array alongside its operations.
+        if (!HTTP_METHODS.has(method)) continue;
+
+        const security = operation.security ?? specWideSecurity;
+        const target = { method: method.toUpperCase(), url: path };
+        if (security.length === 0) {
+          preflight.push(target);
+        } else {
+          authenticated.push(target);
+        }
+      }
+    }
+
+    expect(authenticated.length).toBeGreaterThan(0);
+    expect(preflight.length).toBeGreaterThan(0);
+  });
+
+  test("discovers the internal surface from the spec", () => {
+    expect(authenticated.map((o) => `${o.method} ${o.url}`).sort()).toEqual([
+      "DELETE /internal/pcp-referrals",
+      "DELETE /internal/practices",
+      "DELETE /internal/practices/{practiceId}",
+      "GET /internal/practices",
+      "GET /internal/practices/{practiceId}",
+      "PATCH /internal/practices/{practiceId}",
+      "POST /internal/practices",
+    ]);
+    expect(preflight.map((o) => `${o.method} ${o.url}`).sort()).toEqual([
+      "OPTIONS /internal/pcp-referrals",
+      "OPTIONS /internal/practices",
+      "OPTIONS /internal/practices/{practiceId}",
+    ]);
+  });
+
+  test("every authenticated operation rejects a missing Authorization header with 401", async () => {
+    for (const { method, url } of authenticated) {
+      const res = await serverHelper.getServer().inject({ method, url });
+
+      expect(res.statusCode, `${method} ${url}`).toBe(401);
+      expect(res.json(), `${method} ${url}`).toMatchObject({
+        errorType: "AuthenticationError",
+      });
+    }
+  });
+
+  test("every authenticated operation rejects a key outside the allowlist with 401", async () => {
+    for (const { method, url } of authenticated) {
+      const res = await serverHelper.getServer().inject({
+        method,
+        url,
+        headers: { authorization: "Bearer not-an-allowlisted-key" },
+      });
+
+      expect(res.statusCode, `${method} ${url}`).toBe(401);
+      expect(res.json(), `${method} ${url}`).toMatchObject({
+        errorType: "AuthenticationError",
+      });
+    }
+  });
+
+  test("every authenticated operation rejects a non-Bearer scheme with 401", async () => {
+    for (const { method, url } of authenticated) {
+      const res = await serverHelper.getServer().inject({
+        method,
+        url,
+        headers: { authorization: "Basic valid-test-key" },
+      });
+
+      expect(res.statusCode, `${method} ${url}`).toBe(401);
+    }
+  });
+
+  test("every authenticated operation rejects a bare key with no scheme prefix with 401", async () => {
+    for (const { method, url } of authenticated) {
+      const res = await serverHelper.getServer().inject({
+        method,
+        url,
+        headers: { authorization: "valid-test-key" },
+      });
+
+      expect(res.statusCode, `${method} ${url}`).toBe(401);
+    }
+  });
+
+  test("the declared x-api-key header alone does not authenticate — the scheme is bearer", async () => {
