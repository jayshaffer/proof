+import type { FastifyInstance } from "fastify";
+import { describe, expect, test, vi } from "vitest";
+import { useServerHelper } from "../util";
+
+vi.mock("../../config");
+
+type ServedSpec = {
+  servers?: { url: string; description?: string; "x-internal"?: boolean }[];
+  paths?: Record<string, Record<string, { operationId?: string }>>;
+  components?: {
+    securitySchemes?: Record<
+      string,
+      { type?: string; scheme?: string; in?: string; name?: string }
+    >;
+  };
+};
+
+async function fetchInternalSpec(server: FastifyInstance): Promise<ServedSpec> {
+  const res = await server.inject({ method: "GET", url: "/internal-documentation/json" });
+  expect(res.statusCode).toBe(200);
+  return res.json() as ServedSpec;
+}
+
+describe("internal spec contract", () => {
+  const serverHelper = useServerHelper();
+
+  test("declares apiKeyAuth as HTTP bearer, matching what apiKeyAuth actually reads", async () => {
+    const spec = await fetchInternalSpec(serverHelper.getServer());
+
+    expect(spec.components?.securitySchemes?.apiKeyAuth).toMatchObject({
+      type: "http",
+      scheme: "bearer",
+    });
+  });
+
+  test("does not declare apiKeyAuth as an x-api-key header scheme", async () => {
+    const spec = await fetchInternalSpec(serverHelper.getServer());
+    const scheme = spec.components?.securitySchemes?.apiKeyAuth;
+
+    expect(scheme?.type).not.toBe("apiKey");
+    expect(scheme?.in).toBeUndefined();
+    expect(scheme?.name).toBeUndefined();
+  });
+
+  test("lists local, dev-int, and prod-int servers, all flagged internal", async () => {
+    const spec = await fetchInternalSpec(serverHelper.getServer());
+
+    expect(spec.servers?.map((s) => s.url)).toEqual([
+      "http://localhost:3024",
+      "https://attribution-service.dev-int.rula.com",
+      "https://attribution-service.prod-int.rula.com",
+    ]);
+    expect(spec.servers?.every((s) => s["x-internal"] === true)).toBe(true);
+  });
+
+  test("lists every internal operationId so missing glue wiring fails here, not in a browser", async () => {
+    const spec = await fetchInternalSpec(serverHelper.getServer());
+
+    const operationIds = Object.values(spec.paths ?? {})
+      .flatMap((methods) => Object.values(methods))
+      .map((operation) => operation.operationId)
+      .filter((id): id is string => typeof id === "string")
+      .sort();
+
+    expect(operationIds).toEqual([
+      "createPractice",
+      "deleteAllPcpReferrals",
+      "deleteAllPractices",
+      "deletePractice",
+      "getInternalPractice",
+      "listInternalPractices",
+      "optionsInternalPcpReferrals",
+      "optionsInternalPractices",
+      "optionsInternalPracticesPracticeId",
+      "updatePractice",
+    ]);
+  });
+});
