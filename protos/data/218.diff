diff --git a/apps/api/src/service/internal-practice-service.ts b/apps/api/src/service/internal-practice-service.ts
new file mode 100644
index 00000000..c904ae80
--- /dev/null
+++ b/apps/api/src/service/internal-practice-service.ts
@@ -0,0 +1,86 @@
+import type { Practice, PracticeStatus } from "@attribution-service/data";
+import { practiceRepository } from "@attribution-service/data";
+import type { components } from "../generated/internal-types";
+
+type InternalPractice = components["schemas"]["InternalPractice"];
+type CreateRequest = components["schemas"]["CreateInternalPracticeRequest"];
+type UpdateRequest = components["schemas"]["UpdateInternalPracticeRequest"];
+
+export type ListFilters = {
+  name?: string;
+  status?: PracticeStatus;
+  accountManager?: string;
+  limit?: number;
+  cursor?: string;
+};
+
+/**
+ * Absent optional attributes are omitted rather than serialized as null, so a
+ * response mirrors what is actually stored.
+ */
+export function toInternalPractice(practice: Practice): InternalPractice {
+  return {
+    id: practice.id,
+    name: practice.name,
+    status: practice.status,
+    ...(practice.accountManager !== undefined && { accountManager: practice.accountManager }),
+    ...(practice.practiceEmail !== undefined && { practiceEmail: practice.practiceEmail }),
+    ...(practice.lastReferralDate !== undefined && {
+      lastReferralDate: practice.lastReferralDate,
+    }),
+    createdAt: practice.createdAt.toISOString(),
+    updatedAt: practice.updatedAt.toISOString(),
+  };
+}
+
+export async function createPractice(request: CreateRequest): Promise<InternalPractice> {
+  const created = await practiceRepository.createPractice(request);
+  return toInternalPractice(created);
+}
+
+export async function getPractice(id: string): Promise<InternalPractice | null> {
+  const practice = await practiceRepository.getPractice(id);
+  return practice ? toInternalPractice(practice) : null;
+}
+
+export async function updatePractice(
+  id: string,
+  request: UpdateRequest,
+): Promise<InternalPractice | null> {
+  const patched = await practiceRepository.patchPractice(id, request);
+  return patched ? toInternalPractice(patched) : null;
+}
+
+export async function deletePractice(id: string): Promise<boolean> {
+  return practiceRepository.deletePractice(id);
+}
+
+export async function listPractices(
+  filters: ListFilters = {},
+): Promise<{ practices: InternalPractice[]; nextCursor?: string }> {
+  const page = await fetchPage(filters);
+
+  return {
+    practices: page.practices.map(toInternalPractice),
+    ...(page.nextCursor !== undefined && { nextCursor: page.nextCursor }),
+  };
+}
+
+/**
+ * At most one filter is honoured, in declaration order, so each lookup is served
+ * by its own GSI rather than by a scan-and-filter.
+ */
+function fetchPage(filters: ListFilters) {
+  const { name, status, accountManager, limit, cursor } = filters;
+
+  if (name !== undefined) {
+    return practiceRepository.listPracticesByName(name, limit, cursor);
+  }
+  if (status !== undefined) {
+    return practiceRepository.listPracticesByStatus(status, limit, cursor);
+  }
+  if (accountManager !== undefined) {
+    return practiceRepository.listPracticesByAccountManager(accountManager, limit, cursor);
+  }
+  return practiceRepository.listPractices(limit, cursor);
+}
