diff --git a/packages/data/src/repository/patch-fields.ts b/packages/data/src/repository/patch-fields.ts
new file mode 100644
index 00000000..019f856b
--- /dev/null
+++ b/packages/data/src/repository/patch-fields.ts
@@ -0,0 +1,31 @@
+/**
+ * Patch semantics shared by the practice and referral repositories:
+ * an explicit `null` clears the attribute, an omitted key leaves it alone.
+ * This is deliberately different from the `upsert*` ingest methods, where
+ * omission can mean "wipe" (see upsertReferral).
+ */
+
+/** Keys whose value may be `null`, i.e. the attributes a patch is allowed to clear. */
+type NullableKeys<T> = { [K in keyof T]-?: null extends T[K] ? K : never }[keyof T];
+
+type SettableFields<T> = { [K in keyof T]?: Exclude<T[K], null> };
+
+export function splitPatchFields<T extends Record<string, unknown>>(
+  fields: T,
+): { toSet: SettableFields<T>; toRemove: (NullableKeys<T> & string)[] } {
+  const toSet: Record<string, unknown> = {};
+  const toRemove: string[] = [];
+
+  for (const [key, value] of Object.entries(fields)) {
+    if (value === null) {
+      toRemove.push(key);
+    } else if (value !== undefined) {
+      toSet[key] = value;
+    }
+  }
+
+  return {
+    toSet: toSet as SettableFields<T>,
+    toRemove: toRemove as (NullableKeys<T> & string)[],
+  };
+}
