new file mode 100644
index 00000000..f3de897e
--- /dev/null
+++ b/apps/api/src/service/internal-pcp-referral-service.ts
@@ -0,0 +1,117 @@
+import type { Referral } from "@attribution-service/data";
+import { referralRepository } from "@attribution-service/data";
+import type { components } from "../generated/internal-types";
+
+type InternalPcpReferral = components["schemas"]["InternalPcpReferral"];
+type CreateRequest = components["schemas"]["CreateInternalPcpReferralRequest"];
+type UpdateRequest = components["schemas"]["UpdateInternalPcpReferralRequest"];
+
+type Pagination = { limit?: number; cursor?: string };
+
+/**
+ * Exactly one filter selects the index the list is served from. Modelled as a
+ * union so a filterless call is a type error rather than a runtime surprise —
+ * unfiltered referral listing is not offered (these records carry PHI).
+ */
+export type ReferralListFilters = Pagination &
+  (
+    | { practiceName: string }
+    | { cleanReferrerName: string }
+    | { referringProviderId: string }
+    | { fullName: string }
+  );
+
+const OPTIONAL_FIELDS = [
+  "mobile",
+  "email",
+  "networkName",
+  "insuranceCarrier",
+  "utmSource",
+  "practiceOwnerName",
+  "practiceAccountId",
+  "sourceRunId",
+  "producedAt",
+  "therapyLeadStage",
+  "psychLeadStage",
+  "therapyLeadSubstage",
+] as const;
+
+/**
+ * Absent optional attributes are omitted rather than serialized as null, so a
+ * response mirrors what is actually stored.
+ */
+export function toInternalPcpReferral(referral: Referral): InternalPcpReferral {
+  const result: InternalPcpReferral = {
+    id: referral.id,
+    leadId: referral.leadId,
+    fullName: referral.fullName,
+    cleanReferrerName: referral.cleanReferrerName,
+    referringProviderId: referral.referringProviderId,
+    practiceName: referral.practiceName,
+    createdDate: referral.createdDate,
+    therapyOrPsychLead: referral.therapyOrPsychLead,
+    createdAt: referral.createdAt.toISOString(),
+    updatedAt: referral.updatedAt.toISOString(),
+  };
+
+  for (const field of OPTIONAL_FIELDS) {
+    const value = referral[field];
+    if (value !== undefined) {
+      Object.assign(result, { [field]: value });
+    }
+  }
+
+  return result;
+}
+
+export async function createReferral(request: CreateRequest): Promise<InternalPcpReferral> {
+  const created = await referralRepository.createReferral(request);
+  return toInternalPcpReferral(created);
+}
+
+export async function getReferral(id: string): Promise<InternalPcpReferral | null> {
+  const referral = await referralRepository.getReferral(id);
+  return referral ? toInternalPcpReferral(referral) : null;
+}
+
+export async function updateReferral(
+  id: string,
+  request: UpdateRequest,
+): Promise<InternalPcpReferral | null> {
+  const patched = await referralRepository.patchReferral(id, request);
+  return patched ? toInternalPcpReferral(patched) : null;
+}
+
+export async function deleteReferral(id: string): Promise<boolean> {
+  return referralRepository.deleteReferral(id);
+}
+
+export async function listReferrals(
+  filters: ReferralListFilters,
+): Promise<{ referrals: InternalPcpReferral[]; nextCursor?: string }> {
+  const page = await fetchPage(filters);
+
+  return {
+    referrals: page.referrals.map(toInternalPcpReferral),
+    ...(page.nextCursor !== undefined && { nextCursor: page.nextCursor }),
+  };
+}
+
+/**
+ * At most one filter is honoured, in declaration order, so every lookup is
+ * served by its own GSI rather than a scan-and-filter.
+ */
+function fetchPage(filters: ReferralListFilters) {
+  const { limit, cursor } = filters;
+
+  if ("practiceName" in filters) {
+    return referralRepository.listReferralsByPractice(filters.practiceName, limit, cursor);
+  }
+  if ("cleanReferrerName" in filters) {
+    return referralRepository.listReferralsByReferrer(filters.cleanReferrerName, limit, cursor);
+  }
+  if ("referringProviderId" in filters) {
+    return referralRepository.listReferralsByProviderId(filters.referringProviderId, limit, cursor);
+  }
+  return referralRepository.listReferralsByFullName(filters.fullName, limit, cursor);
+}
