diff --git a/apps/api/src/__tests__/routes/internal-pcp-referrals-crud.test.ts b/apps/api/src/__tests__/routes/internal-pcp-referrals-crud.test.ts
new file mode 100644
index 00000000..5ef87b3d
--- /dev/null
+++ b/apps/api/src/__tests__/routes/internal-pcp-referrals-crud.test.ts
@@ -0,0 +1,352 @@
+import { clearAllItems, referralRepository } from "@attribution-service/data";
+import { afterEach, describe, expect, test, vi } from "vitest";
+import { useServerHelper } from "../util";
+
+vi.mock("../../config");
+
+const AUTH_HEADER = { authorization: "Bearer valid-test-key" };
+
+/** Every optional field populated, so a patch that disturbs one is visible. */
+const FULL_BODY = {
+  id: "abc123",
+  leadId: "SF-LEAD-001",
+  fullName: "Jane Doe",
+  mobile: "555-111-2222",
+  email: "jane@example.com",
+  cleanReferrerName: "Dr. Smith",
+  referringProviderId: "a0b1c2d3-e4f5-5000-8000-000000000001",
+  networkName: "Blue Shield",
+  insuranceCarrier: "BCBS",
+  utmSource: "pcp",
+  practiceName: "Smith Family Practice",
+  practiceOwnerName: "Dr. Smith",
+  practiceAccountId: "ACCT-001",
+  sourceRunId: "hex-run-001",
+  producedAt: "2026-07-13T00:00:00Z",
+  createdDate: "2026-07-01T00:00:00Z",
+  therapyOrPsychLead: "THERAPY_ONLY" as const,
+  therapyLeadStage: "LEAD" as const,
+  psychLeadStage: "CONTACT" as const,
+  therapyLeadSubstage: "vob_failed",
+};
+
+describe("internal PCP referrals CRUD", () => {
+  const serverHelper = useServerHelper();
+
+  afterEach(async () => {
+    await clearAllItems();
+  });
+
+  const post = (payload: unknown) =>
+    serverHelper.getServer().inject({
+      method: "POST",
+      url: "/internal/pcp-referrals",
+      headers: AUTH_HEADER,
+      payload,
+    });
+
+  const get = (url: string) =>
+    serverHelper.getServer().inject({ method: "GET", url, headers: AUTH_HEADER });
+
+  const patch = (id: string, payload: unknown) =>
+    serverHelper.getServer().inject({
+      method: "PATCH",
+      url: `/internal/pcp-referrals/${id}`,
+      headers: AUTH_HEADER,
+      payload,
+    });
+
+  const del = (url: string) =>
+    serverHelper.getServer().inject({ method: "DELETE", url, headers: AUTH_HEADER });
+
+  describe("POST /internal/pcp-referrals", () => {
+    test("valid body returns 201 with the stored record", async () => {
+      const res = await post(FULL_BODY);
+
+      expect(res.statusCode).toBe(201);
+      expect(res.json()).toMatchObject(FULL_BODY);
+      expect(typeof res.json().createdAt).toBe("string");
+    });
+
+    test("duplicate id returns 409 ConflictError and leaves the record unmodified", async () => {
+      await post(FULL_BODY);
+
+      const res = await post({ ...FULL_BODY, fullName: "Impostor Name" });
+
+      expect(res.statusCode).toBe(409);
+      expect(res.json()).toMatchObject({ errorType: "ConflictError" });
+      expect((await get("/internal/pcp-referrals/abc123")).json().fullName).toBe("Jane Doe");
+    });
+
+    test("missing a required field returns 422 naming it in issues", async () => {
+      const { practiceName, ...withoutPracticeName } = FULL_BODY;
+
+      const res = await post(withoutPracticeName);
+
+      expect(res.statusCode).toBe(422);
+      const body = res.json();
+      expect(body.errorType).toBe("UnprocessableContentError");
+      expect(JSON.stringify(body.issues)).toContain("practiceName");
+    });
+
+    test("therapyOrPsychLead outside LeadType returns 422", async () => {
+      const res = await post({ ...FULL_BODY, therapyOrPsychLead: "NOT_A_LEAD_TYPE" });
+
+      expect(res.statusCode).toBe(422);
+    });
+
+    test("therapyLeadStage outside LeadStage returns 422", async () => {
+      const res = await post({ ...FULL_BODY, therapyLeadStage: "NOT_A_STAGE" });
+
+      expect(res.statusCode).toBe(422);
+    });
+
+    test("supplying server-managed createdAt returns 422", async () => {
+      const res = await post({ ...FULL_BODY, createdAt: "2020-01-01T00:00:00.000Z" });
+
+      expect(res.statusCode).toBe(422);
+    });
+
+    test("created referral is findable under all four GSIs", async () => {
+      await post(FULL_BODY);
+
+      const byPractice = await get(
+        "/internal/pcp-referrals?practiceName=Smith%20Family%20Practice",
+      );
+      const byReferrer = await get("/internal/pcp-referrals?cleanReferrerName=Dr.%20Smith");
+      const byFullName = await get("/internal/pcp-referrals?fullName=Jane%20Doe");
+      const byProvider = await get(
+        "/internal/pcp-referrals?referringProviderId=a0b1c2d3-e4f5-5000-8000-000000000001",
+      );
+
+      for (const res of [byPractice, byReferrer, byFullName, byProvider]) {
+        expect(res.json().referrals.map((r: { id: string }) => r.id)).toEqual(["abc123"]);
+      }
+    });
+  });
+
+  describe("GET /internal/pcp-referrals/{referralId}", () => {
+    test("existing id returns 200 with lead type and both stage fields", async () => {
+      await post(FULL_BODY);
+
+      const res = await get("/internal/pcp-referrals/abc123");
+
+      expect(res.statusCode).toBe(200);
+      expect(res.json()).toMatchObject({
+        therapyOrPsychLead: "THERAPY_ONLY",
+        therapyLeadStage: "LEAD",
+        psychLeadStage: "CONTACT",
+      });
+    });
+
+    test("unknown id returns 404 NotFoundError", async () => {
+      const res = await get("/internal/pcp-referrals/does-not-exist");
+
+      expect(res.statusCode).toBe(404);
+      expect(res.json()).toMatchObject({ errorType: "NotFoundError" });
+    });
+
+    test("omitted optional fields are absent, not null", async () => {
+      await post({
+        id: "minimal",
+        leadId: "L1",
+        fullName: "Min Imal",
+        cleanReferrerName: "Dr. Ref",
+        referringProviderId: "prov-1",
+        practiceName: "Some Practice",
+        createdDate: "2026-07-01T00:00:00Z",
+        therapyOrPsychLead: "BOTH",
+      });
+
+      const body = (await get("/internal/pcp-referrals/minimal")).json();
+
+      expect(body).not.toHaveProperty("mobile");
+      expect(body).not.toHaveProperty("email");
+      expect(body).not.toHaveProperty("therapyLeadStage");
+    });
+  });
+
+  describe("GET /internal/pcp-referrals", () => {
+    test("no filter returns 422 — unfiltered listing over PHI is not offered", async () => {
+      await post(FULL_BODY);
+
+      const res = await get("/internal/pcp-referrals");
+
+      expect(res.statusCode).toBe(422);
+      expect(res.json().errorType).toBe("UnprocessableContentError");
+    });
+
+    test("practiceName, cleanReferrerName, and fullName match case-insensitively", async () => {
+      await post(FULL_BODY);
+
+      const byPractice = await get(
+        "/internal/pcp-referrals?practiceName=smith%20family%20practice",
+      );
+      const byReferrer = await get("/internal/pcp-referrals?cleanReferrerName=dr.%20smith");
+      const byFullName = await get("/internal/pcp-referrals?fullName=jane%20doe");
+
+      for (const res of [byPractice, byReferrer, byFullName]) {
+        expect(res.json().referrals.map((r: { id: string }) => r.id)).toEqual(["abc123"]);
+      }
+    });
+
+    test("referringProviderId is case-sensitive because GSI4 is not upper-cased", async () => {
+      await post({ ...FULL_BODY, referringProviderId: "Provider-Mixed-Case" });
+
+      const exact = await get("/internal/pcp-referrals?referringProviderId=Provider-Mixed-Case");
+      const wrongCase = await get(
+        "/internal/pcp-referrals?referringProviderId=provider-mixed-case",
+      );
+
+      expect(exact.json().referrals).toHaveLength(1);
+      expect(wrongCase.json().referrals).toEqual([]);
+    });
+
+    test("limit outside 1-100 returns 422", async () => {
+      const url = "/internal/pcp-referrals?fullName=Jane%20Doe";
+      expect((await get(`${url}&limit=0`)).statusCode).toBe(422);
+      expect((await get(`${url}&limit=101`)).statusCode).toBe(422);
+    });
+
+    test("cursor replay pages without repeats or gaps", async () => {
+      for (const id of ["r1", "r2", "r3"]) {
+        await post({ ...FULL_BODY, id, leadId: `L-${id}` });
+      }
+
+      const first = await get(
+        "/internal/pcp-referrals?practiceName=Smith%20Family%20Practice&limit=2",
+      );
+      expect(first.json().referrals).toHaveLength(2);
+      const cursor = encodeURIComponent(first.json().nextCursor);
+
+      const second = await get(
+        `/internal/pcp-referrals?practiceName=Smith%20Family%20Practice&limit=2&cursor=${cursor}`,
+      );
+
+      const firstIds = first.json().referrals.map((r: { id: string }) => r.id);
+      const secondIds = second.json().referrals.map((r: { id: string }) => r.id);
+
+      expect(secondIds).not.toEqual(expect.arrayContaining(firstIds));
+      expect([...firstIds, ...secondIds].sort()).toEqual(["r1", "r2", "r3"]);
+    });
+  });
+
+  describe("PATCH /internal/pcp-referrals/{referralId}", () => {
+    test("patching one stage field leaves every other field byte-identical", async () => {
+      const created = (await post(FULL_BODY)).json();
+
+      const res = await patch("abc123", { therapyLeadStage: "SCHEDULED" });
+
+      expect(res.statusCode).toBe(200);
+      expect(res.json()).toEqual({
+        ...created,
+        therapyLeadStage: "SCHEDULED",
+        updatedAt: res.json().updatedAt,
+      });
+    });
+
+    test("unknown id returns 404 and does not create the record", async () => {
+      const res = await patch("does-not-exist", { fullName: "Ghost" });
+
+      expect(res.statusCode).toBe(404);
+      expect(await referralRepository.getReferral("does-not-exist")).toBeNull();
+    });
+
+    test("body containing id returns 422 — id is immutable", async () => {
+      await post(FULL_BODY);
+
+      const res = await patch("abc123", { id: "other-id", fullName: "Renamed" });
+
+      expect(res.statusCode).toBe(422);
+    });
+
+    test("null clears only the targeted field, leaving the other optionals intact", async () => {
+      const created = (await post(FULL_BODY)).json();
+
+      const res = await patch("abc123", { mobile: null });
+
+      expect(res.statusCode).toBe(200);
+      expect(res.json()).not.toHaveProperty("mobile");
+      expect(res.json()).toEqual({
+        ...created,
+        mobile: undefined,
+        updatedAt: res.json().updatedAt,
+      });
+    });
+
+    test("clearing a nullable stage field removes it", async () => {
+      await post(FULL_BODY);
+
+      const res = await patch("abc123", { psychLeadStage: null });
+
+      expect(res.statusCode).toBe(200);
+      expect(res.json()).not.toHaveProperty("psychLeadStage");
+      expect(res.json().therapyLeadStage).toBe("LEAD");
+    });
+
+    test("changing practiceName moves the GSI1 partition", async () => {
+      await post(FULL_BODY);
+
+      await patch("abc123", { practiceName: "Jones Family Practice" });
+
+      const old = await get("/internal/pcp-referrals?practiceName=Smith%20Family%20Practice");
+      const fresh = await get("/internal/pcp-referrals?practiceName=Jones%20Family%20Practice");
+
+      expect(old.json().referrals).toEqual([]);
+      expect(fresh.json().referrals.map((r: { id: string }) => r.id)).toEqual(["abc123"]);
+    });
+
+    test("empty body returns 422 rather than issuing a no-op write", async () => {
+      await post(FULL_BODY);
+
+      const res = await patch("abc123", {});
+
+      expect(res.statusCode).toBe(422);
+    });
+
+    test("advances updatedAt and leaves createdAt unchanged", async () => {
+      const created = (await post(FULL_BODY)).json();
+      await new Promise((resolve) => setTimeout(resolve, 25));
+
+      const patched = (await patch("abc123", { fullName: "Jane Roe" })).json();
+
+      expect(patched.createdAt).toBe(created.createdAt);
+      expect(new Date(patched.updatedAt).getTime()).toBeGreaterThan(
+        new Date(created.updatedAt).getTime(),
+      );
+    });
+  });
+
+  describe("DELETE /internal/pcp-referrals/{referralId}", () => {
+    test("existing id returns 204 and removes the record", async () => {
+      await post(FULL_BODY);
+
+      const res = await del("/internal/pcp-referrals/abc123");
+
+      expect(res.statusCode).toBe(204);
+      expect((await get("/internal/pcp-referrals/abc123")).statusCode).toBe(404);
+    });
+
+    test("unknown id returns 404", async () => {
+      expect((await del("/internal/pcp-referrals/does-not-exist")).statusCode).toBe(404);
+    });
+
+    test("deleting one referral leaves the others intact", async () => {
+      await post(FULL_BODY);
+      await post({ ...FULL_BODY, id: "other", leadId: "L-other" });
+
+      await del("/internal/pcp-referrals/abc123");
+
+      expect((await get("/internal/pcp-referrals/other")).statusCode).toBe(200);
+    });
+
+    test("delete-all keeps its existing 204 behavior", async () => {
+      await post(FULL_BODY);
+
+      const res = await del("/internal/pcp-referrals");
+
+      expect(res.statusCode).toBe(204);
+      expect((await get("/internal/pcp-referrals/abc123")).statusCode).toBe(404);
+    });
+  });
+});
