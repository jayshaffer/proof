+/**
+ * The dashboard is typed against the generated internal spec types rather than
+ * the axios SDK: clients/attribution-service-client-ts-axios generates from
+ * docs/openapi.yaml only, so it cannot cover /internal operations. Importing
+ * these means an internal spec change breaks `tsc -b` here.
+ */
+import type { components } from "../../../api/src/generated/internal-types";
+
+export type InternalPractice = components["schemas"]["InternalPractice"];
+export type InternalPracticeListResponse = components["schemas"]["InternalPracticeListResponse"];
+export type CreateInternalPracticeRequest = components["schemas"]["CreateInternalPracticeRequest"];
+export type UpdateInternalPracticeRequest = components["schemas"]["UpdateInternalPracticeRequest"];
+
+export type InternalPcpReferral = components["schemas"]["InternalPcpReferral"];
+export type InternalPcpReferralListResponse =
+  components["schemas"]["InternalPcpReferralListResponse"];
+export type CreateInternalPcpReferralRequest =
+  components["schemas"]["CreateInternalPcpReferralRequest"];
+export type UpdateInternalPcpReferralRequest =
+  components["schemas"]["UpdateInternalPcpReferralRequest"];
+
+export type CohortPreviewResponse = components["schemas"]["CohortPreviewResponse"];
+export type CohortPreviewSkip = components["schemas"]["CohortPreviewSkip"];
+export type SkipReason = components["schemas"]["SkipReason"];
+export type PracticeStatus = components["schemas"]["PracticeStatus"];
+export type LeadType = components["schemas"]["LeadType"];
+export type LeadStage = components["schemas"]["LeadStage"];
+
+export const PRACTICE_STATUSES: PracticeStatus[] = [
+  "SOLD",
+  "ONBOARDING",
+  "STALLED_IN_ONBOARDING",
+  "CHURNED",
+  "OTHER",
+];
+
+export const LEAD_TYPES: LeadType[] = ["PSYCH_ONLY", "THERAPY_ONLY", "BOTH"];
+
+export const LEAD_STAGES: LeadStage[] = [
+  "LEAD",
+  "CONTACT",
+  "HOLD",
+  "REGISTERED",
+  "SCHEDULED",
+  "PATIENT",
+];
diff --git a/apps/dev-dashboard/src/api/internal.ts b/apps/dev-dashboard/src/api/internal.ts
new file mode 100644
index 00000000..96a4a19c
--- /dev/null
+++ b/apps/dev-dashboard/src/api/internal.ts
@@ -0,0 +1,122 @@
+import { createApiClient } from "./client";
+import type {
+  CohortPreviewResponse,
+  CreateInternalPcpReferralRequest,
+  CreateInternalPracticeRequest,
+  InternalPcpReferral,
+  InternalPcpReferralListResponse,
+  InternalPractice,
+  InternalPracticeListResponse,
+  UpdateInternalPcpReferralRequest,
+  UpdateInternalPracticeRequest,
+} from "./internal-types";
+
+export type ApiResult<T> =
+  | { ok: true; status: number; data: T }
+  | { ok: false; status: number | null; message: string; body?: unknown };
+
+export interface ApiTarget {
+  baseUrl: string;
+  apiKey: string;
+}
+
+type Method = "get" | "post" | "patch" | "delete";
+
+async function request<T>(
+  { baseUrl, apiKey }: ApiTarget,
+  method: Method,
+  url: string,
+  body?: unknown,
+): Promise<ApiResult<T>> {
+  const client = createApiClient(baseUrl, apiKey);
+  try {
+    const res = await client.request({
+      method,
+      url,
+      ...(body !== undefined && { data: body }),
+      validateStatus: () => true,
+    });
+
+    if (res.status >= 200 && res.status < 300) {
+      return { ok: true, status: res.status, data: res.data as T };
+    }
+    return {
+      ok: false,
+      status: res.status,
+      message: messageForStatus(res.status),
+      body: res.data,
+    };
+  } catch (err) {
+    return {
+      ok: false,
+      status: null,
+      message: err instanceof Error ? err.message : String(err),
+    };
+  }
+}
+
+function messageForStatus(status: number): string {
+  if (status === 401) return "Invalid or missing API key.";
+  if (status === 404) return "Not found.";
+  if (status === 409) return "Already exists — pick a different id.";
+  if (status === 422) return "Validation failed — see the response body.";
+  return `Unexpected status ${status}.`;
+}
+
+function query(params: Record<string, string | number | undefined>): string {
+  const search = new URLSearchParams();
+  for (const [key, value] of Object.entries(params)) {
+    if (value !== undefined && value !== "") search.set(key, String(value));
+  }
+  const rendered = search.toString();
+  return rendered ? `?${rendered}` : "";
+}
+
+export const practicesApi = {
+  list: (target: ApiTarget, params: Record<string, string | number | undefined>) =>
+    request<InternalPracticeListResponse>(target, "get", `/internal/practices${query(params)}`),
+  get: (target: ApiTarget, id: string) =>
+    request<InternalPractice>(target, "get", `/internal/practices/${encodeURIComponent(id)}`),
+  create: (target: ApiTarget, body: CreateInternalPracticeRequest) =>
+    request<InternalPractice>(target, "post", "/internal/practices", body),
+  update: (target: ApiTarget, id: string, body: UpdateInternalPracticeRequest) =>
+    request<InternalPractice>(
+      target,
+      "patch",
+      `/internal/practices/${encodeURIComponent(id)}`,
+      body,
+    ),
+  remove: (target: ApiTarget, id: string) =>
+    request<null>(target, "delete", `/internal/practices/${encodeURIComponent(id)}`),
+};
+
+export const referralsApi = {
+  list: (target: ApiTarget, params: Record<string, string | number | undefined>) =>
+    request<InternalPcpReferralListResponse>(
+      target,
+      "get",
+      `/internal/pcp-referrals${query(params)}`,
+    ),
+  get: (target: ApiTarget, id: string) =>
+    request<InternalPcpReferral>(
+      target,
+      "get",
+      `/internal/pcp-referrals/${encodeURIComponent(id)}`,
+    ),
+  create: (target: ApiTarget, body: CreateInternalPcpReferralRequest) =>
+    request<InternalPcpReferral>(target, "post", "/internal/pcp-referrals", body),
+  update: (target: ApiTarget, id: string, body: UpdateInternalPcpReferralRequest) =>
+    request<InternalPcpReferral>(
+      target,
+      "patch",
+      `/internal/pcp-referrals/${encodeURIComponent(id)}`,
+      body,
+    ),
+  remove: (target: ApiTarget, id: string) =>
+    request<null>(target, "delete", `/internal/pcp-referrals/${encodeURIComponent(id)}`),
+};
+
+export const cohortPreviewApi = {
+  get: (target: ApiTarget) =>
+    request<CohortPreviewResponse>(target, "get", "/internal/practice-reports/cohort-preview"),
+};
