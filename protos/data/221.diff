diff --git a/scripts-ext/dev-dashboard.sh b/scripts-ext/dev-dashboard.sh
new file mode 100755
index 00000000..72fd38d9
--- /dev/null
+++ b/scripts-ext/dev-dashboard.sh
@@ -0,0 +1,42 @@
+#!/usr/bin/env bash
+#
+# Starts the dev dashboard with branch-aware port configuration.
+#
+# Sourcing worktree-config.sh is the point of this wrapper: it exports
+# VITE_API_BASE_URL pointing at this worktree's API port. Running
+# `pnpm --filter @attribution-service/dev-dashboard start` directly leaves that
+# unset, so the dashboard falls back to :3024 and silently talks to whichever
+# worktree happens to own the default port — or nothing at all.
+#
+
+set -euo pipefail
+
+SCRIPT_DIR=$(cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd)
+REPO_ROOT=$(cd -- "${SCRIPT_DIR}/.." &> /dev/null && pwd)
+
+# shellcheck source=/dev/null
+source "${SCRIPT_DIR}/worktree-config.sh"
+
+# vite.config.ts pins 5174 with strictPort, so a stale dashboard from another
+# worktree fails the bind with an unhelpful error. Name the culprit instead.
+DASHBOARD_PORT=5174
+if command -v lsof >/dev/null 2>&1; then
+    if lsof -iTCP -sTCP:LISTEN -P -n 2>/dev/null | grep -E ":${DASHBOARD_PORT}( |$)" >/dev/null 2>&1; then
+        echo "Error: port ${DASHBOARD_PORT} is already in use — another dev dashboard is running." >&2
+        echo "The dashboard uses strictPort, so it cannot fall back to another port." >&2
+        echo >&2
+        echo "Holder:" >&2
+        lsof -iTCP -sTCP:LISTEN -P -n 2>/dev/null | grep -E ":${DASHBOARD_PORT}( |$)" >&2
+        echo >&2
+        echo "Stop it, or change DEV_FRONTEND_PORTS in .secrets.env and vite.config.ts together" >&2
+        echo "(the API's CORS layer allowlists specific ports, so changing one alone breaks preflight)." >&2
+        exit 1
+    fi
+fi
+
+echo "Dashboard:  http://localhost:${DASHBOARD_PORT}"
+echo "API target: ${VITE_API_BASE_URL}"
+echo
+
+cd "${REPO_ROOT}"
+exec pnpm --filter @attribution-service/dev-dashboard start
diff --git a/scripts-ext/stop-local.sh b/scripts-ext/stop-local.sh
new file mode 100755
index 00000000..27764b14
--- /dev/null
+++ b/scripts-ext/stop-local.sh
@@ -0,0 +1,21 @@
+#!/usr/bin/env bash
+#
+# Stops this worktree's containers only.
+#
+# The compose project name is derived from the worktree path, so every worktree
+# owns an isolated stack. Sourcing worktree-config.sh is what keeps this from
+# tearing down a sibling worktree's LocalStack.
+#
+
+set -euo pipefail
+
+SCRIPT_DIR=$(cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd)
+REPO_ROOT=$(cd -- "${SCRIPT_DIR}/.." &> /dev/null && pwd)
+
+# shellcheck source=/dev/null
+source "${SCRIPT_DIR}/worktree-config.sh"
+
+COMPOSE_FILE=${COMPOSE_FILE:-docker-compose.yml}
+
+cd "${REPO_ROOT}"
+docker compose -p "${LOCALSTACK_PROJECT}" -f "${COMPOSE_FILE}" --profile service down
