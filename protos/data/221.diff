@@ -0,0 +1,132 @@
+import { useState } from "react";
+import { cohortPreviewApi } from "../api/internal";
+import type { CohortPreviewResponse } from "../api/internal-types";
+import { type ResponseState, ResponseViewer } from "../components/ResponseViewer";
+import { useEnvironment } from "../context/EnvironmentContext";
+
+export const OPT_OUT_CAVEAT =
+  "Opt-out status was not verified. The opt-out guard reads an attribute the practice record does not store, so no practice can appear as OPTED_OUT here — this preview does not tell you whether a practice has opted out.";
+
+const READ_ONLY_NOTE =
+  "Read-only: this renders no PDF, writes no ledger row, sends no email, and moves no batch metric.";
+
+export function CohortPreview() {
+  const { baseUrl, apiKey } = useEnvironment();
+  const [preview, setPreview] = useState<CohortPreviewResponse | null>(null);
+  const [state, setState] = useState<ResponseState>({ kind: "idle" });
+
+  async function load() {
+    setState({ kind: "loading" });
+    const result = await cohortPreviewApi.get({ baseUrl, apiKey });
+    if (result.ok) {
+      setPreview(result.data);
+      setState({ kind: "ok", status: result.status, body: null });
+      return;
+    }
+    setPreview(null);
+    setState({
+      kind: "error",
+      status: result.status,
+      message: result.message,
+      body: result.body,
+    });
+  }
+
+  return (
+    <section style={{ display: "flex", flexDirection: "column", gap: "1.25rem" }}>
+      <div>
+        <h2 style={{ margin: "0 0 0.25rem" }}>Monthly batch cohort preview</h2>
+        <p style={{ margin: 0, opacity: 0.65, fontSize: "0.9rem" }}>{READ_ONLY_NOTE}</p>
+      </div>
+
+      <p
+        style={{
+          margin: 0,
+          padding: "0.5rem 0.75rem",
+          background: "rgba(250,204,21,0.12)",
+          border: "1px solid rgba(250,204,21,0.4)",
+          borderRadius: "4px",
+          fontSize: "0.85rem",
+        }}
+      >
+        {OPT_OUT_CAVEAT}
+      </p>
+
+      <button
+        type="button"
+        onClick={load}
+        disabled={state.kind === "loading"}
+        style={{
+          padding: "0.5rem 1rem",
+          alignSelf: "flex-start",
+          background: "rgba(255,255,255,0.06)",
+          border: "1px solid rgba(255,255,255,0.12)",
+          borderRadius: "4px",
+          color: "inherit",
+        }}
+      >
+        {state.kind === "loading" ? "Loading…" : "Load preview"}
+      </button>
+
+      {state.kind === "error" && <ResponseViewer state={state} />}
+
+      {preview && (
+        <div style={{ display: "flex", flexDirection: "column", gap: "1rem" }}>
+          <dl
+            style={{
+              display: "flex",
+              gap: "2rem",
+              margin: 0,
+              flexWrap: "wrap",
+            }}
+          >
+            <div>
+              <dt style={{ fontSize: "0.8rem", opacity: 0.7 }}>Cohort size</dt>
+              <dd style={{ margin: 0, fontSize: "1.4rem" }}>{preview.cohortSize}</dd>
+            </div>
+            <div>
+              <dt style={{ fontSize: "0.8rem", opacity: 0.7 }}>Would proceed</dt>
+              <dd style={{ margin: 0, fontSize: "1.4rem" }}>{preview.proceedCount}</dd>
+            </div>
+            <div>
+              <dt style={{ fontSize: "0.8rem", opacity: 0.7 }}>Would skip</dt>
+              <dd style={{ margin: 0, fontSize: "1.4rem" }}>{preview.skipped.length}</dd>
+            </div>
+          </dl>
+
+          {preview.skipped.length > 0 && (
+            <table style={{ borderCollapse: "collapse", width: "100%", fontSize: "0.9rem" }}>
+              <thead>
+                <tr>
+                  {["practiceId", "practiceName", "reason"].map((heading) => (
+                    <th
+                      key={heading}
+                      style={{
+                        textAlign: "left",
+                        padding: "0.4rem",
+                        borderBottom: "1px solid rgba(255,255,255,0.15)",
+                      }}
+                    >
+                      {heading}
+                    </th>
+                  ))}
+                </tr>
+              </thead>
+              <tbody>
+                {preview.skipped.map((skip) => (
+                  <tr key={skip.practiceId}>
+                    <td style={{ padding: "0.4rem", fontFamily: "monospace" }}>
+                      {skip.practiceId}
+                    </td>
+                    <td style={{ padding: "0.4rem" }}>{skip.practiceName}</td>
+                    <td style={{ padding: "0.4rem" }}>{skip.reason}</td>
+                  </tr>
+                ))}
+              </tbody>
+            </table>
+          )}
+        </div>
+      )}
+    </section>
+  );
+}
