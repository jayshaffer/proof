+import type { InternalPractice } from "../api/internal-types";
+import { EnvironmentProvider } from "../context/EnvironmentContext";
+import { Practices } from "./Practices";
+
+const PRACTICE: InternalPractice = {
+  id: "ACCT-001",
+  name: "Smith Family Practice",
+  status: "SOLD",
+  accountManager: "Jordan Lee",
+  practiceEmail: "front-desk@smith.example",
+  createdAt: "2026-07-01T00:00:00.000Z",
+  updatedAt: "2026-07-01T00:00:00.000Z",
+};
+
+async function openPractice() {
+  render(
+    <EnvironmentProvider>
+      <Practices />
+    </EnvironmentProvider>,
+  );
+
+  await userEvent.click(screen.getByRole("button", { name: "Load practices" }));
+  await userEvent.click(await screen.findByRole("button", { name: "Open" }));
+}
+
+describe("Practices", () => {
+  beforeEach(() => {
+    vi.restoreAllMocks();
+    vi.spyOn(practicesApi, "list").mockResolvedValue({
+      ok: true,
+      status: 200,
+      data: { practices: [PRACTICE] },
+    });
+    vi.spyOn(practicesApi, "get").mockResolvedValue({
+      ok: true,
+      status: 200,
+      data: PRACTICE,
+    });
+  });
+
+  it("exposes no optedOut control — it is not a stored attribute", async () => {
+    await openPractice();
+
+    expect(screen.queryByLabelText(/optedOut/i)).not.toBeInTheDocument();
+    expect(screen.queryByText(/opted ?out/i)).not.toBeInTheDocument();
+  });
+
+  it("requires confirmation before a delete request is sent", async () => {
+    const remove = vi
+      .spyOn(practicesApi, "remove")
+      .mockResolvedValue({ ok: true, status: 204, data: null });
+    await openPractice();
+
+    await userEvent.click(screen.getByRole("button", { name: "Delete practice" }));
+    expect(remove).not.toHaveBeenCalled();
+
+    await userEvent.click(
+      within(screen.getByRole("dialog")).getByRole("button", { name: "Delete practice" }),
+    );
+    await waitFor(() => expect(remove).toHaveBeenCalledWith(expect.anything(), "ACCT-001"));
+  });
+
+  it("patches only changed fields, leaving untouched ones out of the body", async () => {
+    const update = vi
+      .spyOn(practicesApi, "update")
+      .mockResolvedValue({ ok: true, status: 200, data: PRACTICE });
+    await openPractice();
+
+    await userEvent.selectOptions(screen.getByLabelText("status"), "CHURNED");
+    await userEvent.click(screen.getByRole("button", { name: "Save changes" }));
+
+    await waitFor(() => expect(update).toHaveBeenCalled());
+    expect(update.mock.calls[0]?.[2]).toEqual({ status: "CHURNED" });
+  });
+
+  it("sends null for an emptied accountManager so the field is cleared", async () => {
+    const update = vi
+      .spyOn(practicesApi, "update")
+      .mockResolvedValue({ ok: true, status: 200, data: PRACTICE });
+    await openPractice();
+
+    await userEvent.clear(screen.getByLabelText("accountManager"));
+    await userEvent.click(screen.getByRole("button", { name: "Save changes" }));
+
+    await waitFor(() => expect(update).toHaveBeenCalled());
+    expect(update.mock.calls[0]?.[2]).toEqual({ accountManager: null });
+  });
+
+  it("omits optional fields left blank on create rather than sending empty strings", async () => {
+    const create = vi
+      .spyOn(practicesApi, "create")
+      .mockResolvedValue({ ok: true, status: 201, data: PRACTICE });
+    render(
+      <EnvironmentProvider>
+        <Practices />
+      </EnvironmentProvider>,
+    );
+
+    await userEvent.type(screen.getByLabelText("new id"), "ACCT-777");
+    await userEvent.type(screen.getByLabelText("new name"), "Fresh Practice");
+    await userEvent.click(screen.getByRole("button", { name: "Create practice" }));
+
+    await waitFor(() => expect(create).toHaveBeenCalled());
+    expect(create.mock.calls[0]?.[1]).toEqual({
+      id: "ACCT-777",
+      name: "Fresh Practice",
+      status: "SOLD",
+    });
+  });
+
+  it("surfaces a 409 conflict rather than failing silently", async () => {
+    vi.spyOn(practicesApi, "create").mockResolvedValue({
+      ok: false,
+      status: 409,
+      message: "Already exists — pick a different id.",
+      body: { errorType: "ConflictError" },
+    });
+    render(
+      <EnvironmentProvider>
+        <Practices />
+      </EnvironmentProvider>,
+    );
+
+    await userEvent.type(screen.getByLabelText("new id"), "ACCT-001");
+    await userEvent.type(screen.getByLabelText("new name"), "Duplicate");
+    await userEvent.click(screen.getByRole("button", { name: "Create practice" }));
+
+    // ResponseViewer renders the response body when present, falling back to the
+    // message only when the server sent none.
+    expect(await screen.findByText(/409 Error/)).toBeInTheDocument();
+    expect(screen.getByText(/ConflictError/)).toBeInTheDocument();
+  });
+
+  it("falls back to the mapped message when the server sends no body", async () => {
+    vi.spyOn(practicesApi, "create").mockResolvedValue({
+      ok: false,
+      status: 409,
+      message: "Already exists — pick a different id.",
+    });
+    render(
+      <EnvironmentProvider>
+        <Practices />
+      </EnvironmentProvider>,
+    );
+
+    await userEvent.type(screen.getByLabelText("new id"), "ACCT-001");
+    await userEvent.type(screen.getByLabelText("new name"), "Duplicate");
+    await userEvent.click(screen.getByRole("button", { name: "Create practice" }));
+
+    expect(await screen.findByText(/Already exists/)).toBeInTheDocument();
+  });
+});
diff --git a/apps/dev-dashboard/src/pages/Practices.tsx b/apps/dev-dashboard/src/pages/Practices.tsx
new file mode 100644
index 00000000..a7a18fbc
--- /dev/null
+++ b/apps/dev-dashboard/src/pages/Practices.tsx
@@ -0,0 +1,440 @@
+import { useState } from "react";
+import { type ApiTarget, practicesApi } from "../api/internal";
+import {
+  type CreateInternalPracticeRequest,
+  type InternalPractice,
+  PRACTICE_STATUSES,
+  type PracticeStatus,
+  type UpdateInternalPracticeRequest,
+} from "../api/internal-types";
+import { ConfirmDialog } from "../components/ConfirmDialog";
+import { type ResponseState, ResponseViewer } from "../components/ResponseViewer";
+import { useEnvironment } from "../context/EnvironmentContext";
+
+type Filter = "none" | "name" | "status" | "accountManager";
+
+const FIELD_STYLE = {
+  padding: "0.4rem 0.5rem",
+  background: "rgba(255,255,255,0.06)",
+  border: "1px solid rgba(255,255,255,0.12)",
+  borderRadius: "4px",
+  color: "inherit",
+} as const;
+
+export function Practices() {
+  const { baseUrl, apiKey } = useEnvironment();
+  const target: ApiTarget = { baseUrl, apiKey };
+
+  const [filter, setFilter] = useState<Filter>("none");
+  const [filterValue, setFilterValue] = useState("");
+  const [practices, setPractices] = useState<InternalPractice[]>([]);
+  const [listState, setListState] = useState<ResponseState>({ kind: "idle" });
+
+  const [selected, setSelected] = useState<InternalPractice | null>(null);
+  const [pendingDelete, setPendingDelete] = useState<InternalPractice | null>(null);
+  const [mutationState, setMutationState] = useState<ResponseState>({ kind: "idle" });
+
+  async function loadList() {
+    setListState({ kind: "loading" });
+    const params = filter === "none" || filterValue === "" ? {} : { [filter]: filterValue };
+    const result = await practicesApi.list(target, params);
+    if (result.ok) {
+      setPractices(result.data.practices);
+      setListState({ kind: "ok", status: result.status, body: null });
+      return;
+    }
+    setPractices([]);
+    setListState({
+      kind: "error",
+      status: result.status,
+      message: result.message,
+      body: result.body,
+    });
+  }
+
+  async function openDetail(id: string) {
+    const result = await practicesApi.get(target, id);
+    if (result.ok) {
+      setSelected(result.data);
+      setMutationState({ kind: "idle" });
+      return;
+    }
+    setSelected(null);
+    setMutationState({
+      kind: "error",
+      status: result.status,
+      message: result.message,
+      body: result.body,
+    });
+  }
+
+  async function confirmDelete() {
+    const practice = pendingDelete;
+    setPendingDelete(null);
+    if (!practice) return;
+
+    setMutationState({ kind: "loading" });
+    const result = await practicesApi.remove(target, practice.id);
+    if (result.ok) {
+      setMutationState({ kind: "ok", status: result.status, body: null });
+      setSelected(null);
+      await loadList();
+      return;
+    }
+    setMutationState({
+      kind: "error",
+      status: result.status,
+      message: result.message,
+      body: result.body,
+    });
+  }
+
+  return (
+    <section style={{ display: "flex", flexDirection: "column", gap: "1.5rem" }}>
+      <div>
+        <h2 style={{ margin: "0 0 0.25rem" }}>Practices</h2>
+        <p style={{ margin: 0, opacity: 0.65, fontSize: "0.9rem" }}>
+          Full CRUD over stored practice records. Name and account-manager lookups are
+          case-insensitive.
+        </p>
+      </div>
+
+      <div style={{ display: "flex", gap: "0.5rem", alignItems: "flex-end", flexWrap: "wrap" }}>
+        <label style={{ display: "flex", flexDirection: "column", gap: "0.25rem" }}>
+          <span style={{ fontSize: "0.8rem", opacity: 0.8 }}>Filter</span>
+          <select
+            aria-label="Filter"
+            value={filter}
+            onChange={(e) => setFilter(e.target.value as Filter)}
+            style={FIELD_STYLE}
+          >
+            <option value="none">No filter (scan)</option>
+            <option value="name">name</option>
+            <option value="status">status</option>
+            <option value="accountManager">accountManager</option>
+          </select>
+        </label>
+
+        {filter !== "none" && (
+          <div style={{ display: "flex", flexDirection: "column", gap: "0.25rem" }}>
+            <label htmlFor="practice-filter-value" style={{ fontSize: "0.8rem", opacity: 0.8 }}>
+              Value
+            </label>
+            {filter === "status" ? (
+              <select
+                id="practice-filter-value"
+                value={filterValue}
+                onChange={(e) => setFilterValue(e.target.value)}
+                style={FIELD_STYLE}
+              >
+                <option value="">—</option>
+                {PRACTICE_STATUSES.map((status) => (
+                  <option key={status} value={status}>
+                    {status}
+                  </option>
+                ))}
+              </select>
+            ) : (
+              <input
+                id="practice-filter-value"
+                value={filterValue}
+                onChange={(e) => setFilterValue(e.target.value)}
+                style={FIELD_STYLE}
+              />
+            )}
+          </div>
+        )}
+
+        <button type="button" onClick={loadList} style={FIELD_STYLE}>
+          Load practices
+        </button>
+      </div>
+
+      {listState.kind === "error" && <ResponseViewer state={listState} />}
+
+      {practices.length > 0 && (
+        <table style={{ borderCollapse: "collapse", width: "100%", fontSize: "0.9rem" }}>
+          <thead>
+            <tr>
+              {["id", "name", "status", "accountManager", ""].map((heading) => (
+                <th
+                  key={heading}
+                  style={{
+                    textAlign: "left",
+                    padding: "0.4rem",
+                    borderBottom: "1px solid rgba(255,255,255,0.15)",
+                  }}
+                >
+                  {heading}
+                </th>
+              ))}
+            </tr>
+          </thead>
+          <tbody>
+            {practices.map((practice) => (
+              <tr key={practice.id}>
+                <td style={{ padding: "0.4rem", fontFamily: "monospace" }}>{practice.id}</td>
+                <td style={{ padding: "0.4rem" }}>{practice.name}</td>
+                <td style={{ padding: "0.4rem" }}>{practice.status}</td>
+                <td style={{ padding: "0.4rem" }}>{practice.accountManager ?? "—"}</td>
+                <td style={{ padding: "0.4rem" }}>
+                  <button type="button" onClick={() => openDetail(practice.id)} style={FIELD_STYLE}>
+                    Open
+                  </button>
+                </td>
+              </tr>
+            ))}
+          </tbody>
+        </table>
+      )}
+
+      {selected && (
+        <PracticeDetail
+          practice={selected}
+          onDeleteRequested={() => setPendingDelete(selected)}
+          onSaved={async (updated) => {
+            setSelected(updated);
+            setMutationState({ kind: "ok", status: 200, body: updated });
+            await loadList();
+          }}
+          onError={setMutationState}
+          target={target}
+        />
+      )}
+
+      {pendingDelete && (
+        <ConfirmDialog
+          title={`Delete practice ${pendingDelete.id}?`}
+          body="This removes the stored record. Other practices are unaffected."
+          confirmLabel="Delete practice"
+          onConfirm={confirmDelete}
+          onCancel={() => setPendingDelete(null)}
+        />
+      )}
+
+      {mutationState.kind !== "idle" && <ResponseViewer state={mutationState} />}
+
+      <hr style={{ border: "none", borderTop: "1px solid rgba(255,255,255,0.1)" }} />
+
+      <CreatePracticeForm
+        target={target}
+        onCreated={async () => {
+          await loadList();
+        }}
+        onResult={setMutationState}
+      />
+    </section>
+  );
+}
+
+interface DetailProps {
+  practice: InternalPractice;
+  target: ApiTarget;
+  onDeleteRequested: () => void;
+  onSaved: (updated: InternalPractice) => void | Promise<void>;
+  onError: (state: ResponseState) => void;
+}
+
+function PracticeDetail({ practice, target, onDeleteRequested, onSaved, onError }: DetailProps) {
+  const [name, setName] = useState(practice.name);
+  const [status, setStatus] = useState<PracticeStatus>(practice.status);
+  const [accountManager, setAccountManager] = useState(practice.accountManager ?? "");
+  const [practiceEmail, setPracticeEmail] = useState(practice.practiceEmail ?? "");
+
+  async function save() {
+    // An emptied optional field sends null (clear); an unchanged one is omitted.
+    const body: UpdateInternalPracticeRequest = {};
+    if (name !== practice.name) body.name = name;
+    if (status !== practice.status) body.status = status;
+    if (accountManager !== (practice.accountManager ?? "")) {
+      body.accountManager = accountManager === "" ? null : accountManager;
+    }
+    if (practiceEmail !== (practice.practiceEmail ?? "")) {
+      body.practiceEmail = practiceEmail === "" ? null : practiceEmail;
+    }
+
+    if (Object.keys(body).length === 0) {
+      onError({ kind: "error", status: null, message: "No changes to save." });
+      return;
+    }
+
+    const result = await practicesApi.update(target, practice.id, body);
+    if (result.ok) {
+      await onSaved(result.data);
+      return;
+    }
+    onError({
+      kind: "error",
+      status: result.status,
+      message: result.message,
+      body: result.body,
+    });
+  }
+
+  return (
+    <div
+      style={{
+        border: "1px solid rgba(255,255,255,0.12)",
+        borderRadius: "4px",
+        padding: "1rem",
+        display: "flex",
+        flexDirection: "column",
+        gap: "0.75rem",
+      }}
+    >
+      <strong>Practice {practice.id}</strong>
+      <p style={{ margin: 0, fontSize: "0.85rem", opacity: 0.7 }}>
+        Created {practice.createdAt} · Updated {practice.updatedAt}
+      </p>
+
+      <label style={{ display: "flex", flexDirection: "column", gap: "0.25rem" }}>
+        <span style={{ fontSize: "0.8rem", opacity: 0.8 }}>name</span>
+        <input
+          aria-label="name"
+          value={name}
+          onChange={(e) => setName(e.target.value)}
+          style={FIELD_STYLE}
+        />
+      </label>
+
+      <label style={{ display: "flex", flexDirection: "column", gap: "0.25rem" }}>
+        <span style={{ fontSize: "0.8rem", opacity: 0.8 }}>status</span>
+        <select
+          aria-label="status"
+          value={status}
+          onChange={(e) => setStatus(e.target.value as PracticeStatus)}
+          style={FIELD_STYLE}
+        >
+          {PRACTICE_STATUSES.map((value) => (
+            <option key={value} value={value}>
+              {value}
+            </option>
+          ))}
+        </select>
+      </label>
+
+      <label style={{ display: "flex", flexDirection: "column", gap: "0.25rem" }}>
+        <span style={{ fontSize: "0.8rem", opacity: 0.8 }}>accountManager (clear to remove)</span>
+        <input
+          aria-label="accountManager"
+          value={accountManager}
+          onChange={(e) => setAccountManager(e.target.value)}
+          style={FIELD_STYLE}
+        />
+      </label>
+
+      <label style={{ display: "flex", flexDirection: "column", gap: "0.25rem" }}>
+        <span style={{ fontSize: "0.8rem", opacity: 0.8 }}>practiceEmail (clear to remove)</span>
+        <input
+          aria-label="practiceEmail"
+          value={practiceEmail}
+          onChange={(e) => setPracticeEmail(e.target.value)}
+          style={FIELD_STYLE}
+        />
+      </label>
+
+      <div style={{ display: "flex", gap: "0.5rem" }}>
+        <button type="button" onClick={save} style={FIELD_STYLE}>
+          Save changes
+        </button>
+        <button
+          type="button"
+          onClick={onDeleteRequested}
+          style={{ ...FIELD_STYLE, background: "#dc2626", color: "#fff" }}
+        >
+          Delete practice
+        </button>
+      </div>
+    </div>
+  );
+}
+
+interface CreateProps {
+  target: ApiTarget;
+  onCreated: () => void | Promise<void>;
+  onResult: (state: ResponseState) => void;
+}
+
+function CreatePracticeForm({ target, onCreated, onResult }: CreateProps) {
+  const [id, setId] = useState("");
+  const [name, setName] = useState("");
+  const [status, setStatus] = useState<PracticeStatus>("SOLD");
+  const [accountManager, setAccountManager] = useState("");
+  const [practiceEmail, setPracticeEmail] = useState("");
+
+  async function submit() {
+    const body: CreateInternalPracticeRequest = {
+      id,
+      name,
+      status,
+      ...(accountManager !== "" && { accountManager }),
+      ...(practiceEmail !== "" && { practiceEmail }),
+    };
+
+    const result = await practicesApi.create(target, body);
+    if (result.ok) {
+      onResult({ kind: "ok", status: result.status, body: result.data });
+      setId("");
+      setName("");
+      await onCreated();
+      return;
+    }
+    onResult({
+      kind: "error",
+      status: result.status,
+      message: result.message,
+      body: result.body,
+    });
+  }
+
+  return (
+    <div style={{ display: "flex", flexDirection: "column", gap: "0.75rem" }}>
+      <strong>Create a practice</strong>
+      <div style={{ display: "flex", gap: "0.5rem", flexWrap: "wrap" }}>
+        <input
+          aria-label="new id"
+          placeholder="id"
+          value={id}
+          onChange={(e) => setId(e.target.value)}
+          style={FIELD_STYLE}
+        />
+        <input
+          aria-label="new name"
+          placeholder="name"
+          value={name}
+          onChange={(e) => setName(e.target.value)}
+          style={FIELD_STYLE}
+        />
+        <select
+          aria-label="new status"
+          value={status}
+          onChange={(e) => setStatus(e.target.value as PracticeStatus)}
+          style={FIELD_STYLE}
+        >
+          {PRACTICE_STATUSES.map((value) => (
+            <option key={value} value={value}>
+              {value}
+            </option>
+          ))}
+        </select>
+        <input
+          aria-label="new accountManager"
+          placeholder="accountManager"
+          value={accountManager}
+          onChange={(e) => setAccountManager(e.target.value)}
+          style={FIELD_STYLE}
+        />
+        <input
+          aria-label="new practiceEmail"
+          placeholder="practiceEmail"
+          value={practiceEmail}
+          onChange={(e) => setPracticeEmail(e.target.value)}
+          style={FIELD_STYLE}
+        />
+        <button type="button" onClick={submit} disabled={!(id && name)} style={FIELD_STYLE}>
+          Create practice
+        </button>
+      </div>
+    </div>
+  );
+}
