@@ -0,0 +1,80 @@
+import { render, screen } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { cohortPreviewApi } from "../api/internal";
+import { EnvironmentProvider } from "../context/EnvironmentContext";
+import { CohortPreview, OPT_OUT_CAVEAT } from "./CohortPreview";
+
+function renderPage() {
+  render(
+    <EnvironmentProvider>
+      <CohortPreview />
+    </EnvironmentProvider>,
+  );
+}
+
+describe("CohortPreview", () => {
+  beforeEach(() => {
+    vi.restoreAllMocks();
+    vi.spyOn(cohortPreviewApi, "get").mockResolvedValue({
+      ok: true,
+      status: 200,
+      data: {
+        cohortSize: 3,
+        proceedCount: 2,
+        skipped: [
+          {
+            practiceId: "ACCT-9",
+            practiceName: "No Email Practice",
+            reason: "NO_PRACTICE_CONTACT_EMAIL",
+          },
+        ],
+        optOutVerified: false,
+      },
+    });
+  });
+
+  it("renders the opt-out caveat before any request is made", () => {
+    renderPage();
+
+    expect(screen.getByText(OPT_OUT_CAVEAT)).toBeInTheDocument();
+    expect(OPT_OUT_CAVEAT).toMatch(/not verified/i);
+  });
+
+  it("states that the preview is read-only", () => {
+    renderPage();
+
+    expect(screen.getByText(/renders no PDF/i)).toBeInTheDocument();
+    expect(screen.getByText(/moves no batch metric/i)).toBeInTheDocument();
+  });
+
+  it("shows cohort size, proceed count, and each skip with its reason", async () => {
+    renderPage();
+
+    await userEvent.click(screen.getByRole("button", { name: "Load preview" }));
+
+    expect(await screen.findByText("3")).toBeInTheDocument();
+    expect(screen.getByText("2")).toBeInTheDocument();
+    expect(screen.getByText("ACCT-9")).toBeInTheDocument();
+    expect(screen.getByText("NO_PRACTICE_CONTACT_EMAIL")).toBeInTheDocument();
+  });
+
+  it("keeps the caveat visible after results load", async () => {
+    renderPage();
+
+    await userEvent.click(screen.getByRole("button", { name: "Load preview" }));
+    await screen.findByText("ACCT-9");
+
+    expect(screen.getByText(OPT_OUT_CAVEAT)).toBeInTheDocument();
+  });
+
+  it("persists nothing from the preview response to storage", async () => {
+    renderPage();
+
+    await userEvent.click(screen.getByRole("button", { name: "Load preview" }));
+    await screen.findByText("ACCT-9");
+
+    expect(JSON.stringify(localStorage)).not.toContain("No Email Practice");
+    expect(JSON.stringify(sessionStorage)).not.toContain("No Email Practice");
+  });
+});
