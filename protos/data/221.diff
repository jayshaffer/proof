@@ -0,0 +1,343 @@
+import { useState } from "react";
+import { type ApiTarget, referralsApi } from "../api/internal";
+import {
+  type InternalPcpReferral,
+  LEAD_STAGES,
+  type LeadStage,
+  type UpdateInternalPcpReferralRequest,
+} from "../api/internal-types";
+import { ConfirmDialog } from "../components/ConfirmDialog";
+import { type ResponseState, ResponseViewer } from "../components/ResponseViewer";
+import { useEnvironment } from "../context/EnvironmentContext";
+
+export const INGEST_OVERWRITE_WARNING =
+  "Edits here are overwritten by the next Hex ingest run. Treat them as temporary test state, not a durable correction.";
+
+type Filter = "practiceName" | "cleanReferrerName" | "referringProviderId" | "fullName";
+
+const FILTERS: Array<{ value: Filter; label: string }> = [
+  { value: "practiceName", label: "practiceName" },
+  { value: "cleanReferrerName", label: "cleanReferrerName" },
+  { value: "referringProviderId", label: "referringProviderId (case-sensitive)" },
+  { value: "fullName", label: "fullName" },
+];
+
+const FIELD_STYLE = {
+  padding: "0.4rem 0.5rem",
+  background: "rgba(255,255,255,0.06)",
+  border: "1px solid rgba(255,255,255,0.12)",
+  borderRadius: "4px",
+  color: "inherit",
+} as const;
+
+type PendingAction =
+  | { kind: "delete"; referral: InternalPcpReferral }
+  | { kind: "save"; referral: InternalPcpReferral; body: UpdateInternalPcpReferralRequest };
+
+export function PcpReferrals() {
+  const { baseUrl, apiKey } = useEnvironment();
+  const target: ApiTarget = { baseUrl, apiKey };
+
+  const [filter, setFilter] = useState<Filter>("practiceName");
+  const [filterValue, setFilterValue] = useState("");
+  const [referrals, setReferrals] = useState<InternalPcpReferral[]>([]);
+  const [listState, setListState] = useState<ResponseState>({ kind: "idle" });
+
+  const [selected, setSelected] = useState<InternalPcpReferral | null>(null);
+  const [pending, setPending] = useState<PendingAction | null>(null);
+  const [mutationState, setMutationState] = useState<ResponseState>({ kind: "idle" });
+
+  async function loadList() {
+    setListState({ kind: "loading" });
+    const result = await referralsApi.list(target, { [filter]: filterValue });
+    if (result.ok) {
+      setReferrals(result.data.referrals);
+      setListState({ kind: "ok", status: result.status, body: null });
+      return;
+    }
+    setReferrals([]);
+    setListState({
+      kind: "error",
+      status: result.status,
+      message: result.message,
+      body: result.body,
+    });
+  }
+
+  async function runPending() {
+    const action = pending;
+    setPending(null);
+    if (!action) return;
+
+    setMutationState({ kind: "loading" });
+    const result =
+      action.kind === "delete"
+        ? await referralsApi.remove(target, action.referral.id)
+        : await referralsApi.update(target, action.referral.id, action.body);
+
+    if (result.ok) {
+      setMutationState({ kind: "ok", status: result.status, body: null });
+      setSelected(action.kind === "delete" ? null : (result.data as InternalPcpReferral));
+      await loadList();
+      return;
+    }
+    setMutationState({
+      kind: "error",
+      status: result.status,
+      message: result.message,
+      body: result.body,
+    });
+  }
+
+  return (
+    <section style={{ display: "flex", flexDirection: "column", gap: "1.5rem" }}>
+      <div>
+        <h2 style={{ margin: "0 0 0.25rem" }}>PCP Referrals</h2>
+        <p style={{ margin: 0, opacity: 0.65, fontSize: "0.9rem" }}>
+          These records carry patient data. A filter is required — unfiltered listing is not
+          offered.
+        </p>
+      </div>
+
+      <div style={{ display: "flex", gap: "0.5rem", alignItems: "flex-end", flexWrap: "wrap" }}>
+        <label style={{ display: "flex", flexDirection: "column", gap: "0.25rem" }}>
+          <span style={{ fontSize: "0.8rem", opacity: 0.8 }}>Filter</span>
+          <select
+            aria-label="Filter"
+            value={filter}
+            onChange={(e) => setFilter(e.target.value as Filter)}
+            style={FIELD_STYLE}
+          >
+            {FILTERS.map(({ value, label }) => (
+              <option key={value} value={value}>
+                {label}
+              </option>
+            ))}
+          </select>
+        </label>
+        <label style={{ display: "flex", flexDirection: "column", gap: "0.25rem" }}>
+          <span style={{ fontSize: "0.8rem", opacity: 0.8 }}>Value</span>
+          <input
+            aria-label="Filter value"
+            value={filterValue}
+            onChange={(e) => setFilterValue(e.target.value)}
+            style={FIELD_STYLE}
+          />
+        </label>
+        <button type="button" onClick={loadList} disabled={!filterValue} style={FIELD_STYLE}>
+          Load referrals
+        </button>
+      </div>
+
+      {listState.kind === "error" && <ResponseViewer state={listState} />}
+
+      {referrals.length > 0 && (
+        <table style={{ borderCollapse: "collapse", width: "100%", fontSize: "0.9rem" }}>
+          <thead>
+            <tr>
+              {["id", "fullName", "practiceName", "therapyOrPsychLead", ""].map((heading) => (
+                <th
+                  key={heading}
+                  style={{
+                    textAlign: "left",
+                    padding: "0.4rem",
+                    borderBottom: "1px solid rgba(255,255,255,0.15)",
+                  }}
+                >
+                  {heading}
+                </th>
+              ))}
+            </tr>
+          </thead>
+          <tbody>
+            {referrals.map((referral) => (
+              <tr key={referral.id}>
+                <td style={{ padding: "0.4rem", fontFamily: "monospace" }}>{referral.id}</td>
+                <td style={{ padding: "0.4rem" }}>{referral.fullName}</td>
+                <td style={{ padding: "0.4rem" }}>{referral.practiceName}</td>
+                <td style={{ padding: "0.4rem" }}>{referral.therapyOrPsychLead}</td>
+                <td style={{ padding: "0.4rem" }}>
+                  <button
+                    type="button"
+                    onClick={() => {
+                      setSelected(referral);
+                      setMutationState({ kind: "idle" });
+                    }}
+                    style={FIELD_STYLE}
+                  >
+                    Open
+                  </button>
+                </td>
+              </tr>
+            ))}
+          </tbody>
+        </table>
+      )}
+
+      {selected && (
+        <ReferralEditForm
+          referral={selected}
+          onSaveRequested={(body) => setPending({ kind: "save", referral: selected, body })}
+          onDeleteRequested={() => setPending({ kind: "delete", referral: selected })}
+          onNoChanges={() =>
+            setMutationState({ kind: "error", status: null, message: "No changes to save." })
+          }
+        />
+      )}
+
+      {pending && (
+        <ConfirmDialog
+          title={
+            pending.kind === "delete"
+              ? `Delete referral ${pending.referral.id}?`
+              : `Save changes to referral ${pending.referral.id}?`
+          }
+          body={
+            pending.kind === "delete"
+              ? "This removes a record containing patient data. Other referrals are unaffected."
+              : INGEST_OVERWRITE_WARNING
+          }
+          confirmLabel={pending.kind === "delete" ? "Delete referral" : "Save changes"}
+          onConfirm={runPending}
+          onCancel={() => setPending(null)}
+        />
+      )}
+
+      {mutationState.kind !== "idle" && <ResponseViewer state={mutationState} />}
+    </section>
+  );
+}
+
+interface EditProps {
+  referral: InternalPcpReferral;
+  onSaveRequested: (body: UpdateInternalPcpReferralRequest) => void;
+  onDeleteRequested: () => void;
+  onNoChanges: () => void;
+}
+
+function ReferralEditForm({
+  referral,
+  onSaveRequested,
+  onDeleteRequested,
+  onNoChanges,
+}: EditProps) {
+  const [therapyLeadStage, setTherapyLeadStage] = useState(referral.therapyLeadStage ?? "");
+  const [psychLeadStage, setPsychLeadStage] = useState(referral.psychLeadStage ?? "");
+  const [mobile, setMobile] = useState(referral.mobile ?? "");
+  const [email, setEmail] = useState(referral.email ?? "");
+
+  function requestSave() {
+    // An emptied optional field sends null (clear); an unchanged one is omitted,
+    // so saving one stage field cannot disturb the others.
+    const body: UpdateInternalPcpReferralRequest = {};
+    if (therapyLeadStage !== (referral.therapyLeadStage ?? "")) {
+      body.therapyLeadStage = therapyLeadStage === "" ? null : (therapyLeadStage as LeadStage);
+    }
+    if (psychLeadStage !== (referral.psychLeadStage ?? "")) {
+      body.psychLeadStage = psychLeadStage === "" ? null : (psychLeadStage as LeadStage);
+    }
+    if (mobile !== (referral.mobile ?? "")) body.mobile = mobile === "" ? null : mobile;
+    if (email !== (referral.email ?? "")) body.email = email === "" ? null : email;
+
+    if (Object.keys(body).length === 0) {
+      onNoChanges();
+      return;
+    }
+    onSaveRequested(body);
+  }
+
+  return (
+    <div
+      style={{
+        border: "1px solid rgba(255,255,255,0.12)",
+        borderRadius: "4px",
+        padding: "1rem",
+        display: "flex",
+        flexDirection: "column",
+        gap: "0.75rem",
+      }}
+    >
+      <strong>Referral {referral.id}</strong>
+
+      <p
+        style={{
+          margin: 0,
+          padding: "0.5rem 0.75rem",
+          background: "rgba(250,204,21,0.12)",
+          border: "1px solid rgba(250,204,21,0.4)",
+          borderRadius: "4px",
+          fontSize: "0.85rem",
+        }}
+      >
+        {INGEST_OVERWRITE_WARNING}
+      </p>
+
+      <label style={{ display: "flex", flexDirection: "column", gap: "0.25rem" }}>
+        <span style={{ fontSize: "0.8rem", opacity: 0.8 }}>therapyLeadStage</span>
+        <select
+          aria-label="therapyLeadStage"
+          value={therapyLeadStage}
+          onChange={(e) => setTherapyLeadStage(e.target.value)}
+          style={FIELD_STYLE}
+        >
+          <option value="">— (clear)</option>
+          {LEAD_STAGES.map((stage) => (
+            <option key={stage} value={stage}>
+              {stage}
+            </option>
+          ))}
+        </select>
+      </label>
+
+      <label style={{ display: "flex", flexDirection: "column", gap: "0.25rem" }}>
+        <span style={{ fontSize: "0.8rem", opacity: 0.8 }}>psychLeadStage</span>
+        <select
+          aria-label="psychLeadStage"
+          value={psychLeadStage}
+          onChange={(e) => setPsychLeadStage(e.target.value)}
+          style={FIELD_STYLE}
+        >
+          <option value="">— (clear)</option>
+          {LEAD_STAGES.map((stage) => (
+            <option key={stage} value={stage}>
+              {stage}
+            </option>
+          ))}
+        </select>
+      </label>
+
+      <label style={{ display: "flex", flexDirection: "column", gap: "0.25rem" }}>
+        <span style={{ fontSize: "0.8rem", opacity: 0.8 }}>mobile (clear to remove)</span>
+        <input
+          aria-label="mobile"
+          value={mobile}
+          onChange={(e) => setMobile(e.target.value)}
+          style={FIELD_STYLE}
+        />
+      </label>
+
+      <label style={{ display: "flex", flexDirection: "column", gap: "0.25rem" }}>
+        <span style={{ fontSize: "0.8rem", opacity: 0.8 }}>email (clear to remove)</span>
+        <input
+          aria-label="email"
+          value={email}
+          onChange={(e) => setEmail(e.target.value)}
+          style={FIELD_STYLE}
+        />
+      </label>
+
+      <div style={{ display: "flex", gap: "0.5rem" }}>
+        <button type="button" onClick={requestSave} style={FIELD_STYLE}>
+          Save changes
+        </button>
+        <button
+          type="button"
+          onClick={onDeleteRequested}
+          style={{ ...FIELD_STYLE, background: "#dc2626", color: "#fff" }}
+        >
+          Delete referral
+        </button>
+      </div>
+    </div>
+  );
+}
diff --git a/apps/dev-dashboard/src/pages/Practices.test.tsx b/apps/dev-dashboard/src/pages/Practices.test.tsx
