+import { render, screen, waitFor, within } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { referralsApi } from "../api/internal";
+import type { InternalPcpReferral } from "../api/internal-types";
+import { EnvironmentProvider } from "../context/EnvironmentContext";
+import { INGEST_OVERWRITE_WARNING, PcpReferrals } from "./PcpReferrals";
+
+const REFERRAL: InternalPcpReferral = {
+  id: "abc123",
+  leadId: "SF-LEAD-001",
+  fullName: "Jane Doe",
+  mobile: "555-111-2222",
+  email: "jane@example.com",
+  cleanReferrerName: "Dr. Smith",
+  referringProviderId: "prov-1",
+  practiceName: "Smith Family Practice",
+  createdDate: "2026-07-01T00:00:00Z",
+  therapyOrPsychLead: "THERAPY_ONLY",
+  therapyLeadStage: "LEAD",
+  psychLeadStage: "CONTACT",
+  createdAt: "2026-07-01T00:00:00.000Z",
+  updatedAt: "2026-07-01T00:00:00.000Z",
+};
+
+async function openReferral() {
+  render(
+    <EnvironmentProvider>
+      <PcpReferrals />
+    </EnvironmentProvider>,
+  );
+
+  await userEvent.type(screen.getByLabelText("Filter value"), "Smith Family Practice");
+  await userEvent.click(screen.getByRole("button", { name: "Load referrals" }));
+  await userEvent.click(await screen.findByRole("button", { name: "Open" }));
+}
+
+describe("PcpReferrals", () => {
+  beforeEach(() => {
+    vi.restoreAllMocks();
+    vi.spyOn(referralsApi, "list").mockResolvedValue({
+      ok: true,
+      status: 200,
+      data: { referrals: [REFERRAL] },
+    });
+  });
+
+  it("requires confirmation before a delete request is sent", async () => {
+    const remove = vi.spyOn(referralsApi, "remove").mockResolvedValue({
+      ok: true,
+      status: 204,
+      data: null,
+    });
+    await openReferral();
+
+    await userEvent.click(screen.getByRole("button", { name: "Delete referral" }));
+
+    // The dialog is up and nothing has been sent yet.
+    const dialog = screen.getByRole("dialog");
+    expect(remove).not.toHaveBeenCalled();
+
+    await userEvent.click(within(dialog).getByRole("button", { name: "Delete referral" }));
+    await waitFor(() => expect(remove).toHaveBeenCalledWith(expect.anything(), "abc123"));
+  });
+
+  it("sends no delete request when the confirmation is cancelled", async () => {
+    const remove = vi.spyOn(referralsApi, "remove").mockResolvedValue({
+      ok: true,
+      status: 204,
+      data: null,
+    });
+    await openReferral();
+
+    await userEvent.click(screen.getByRole("button", { name: "Delete referral" }));
+    await userEvent.click(screen.getByRole("button", { name: "Cancel" }));
+
+    expect(screen.queryByRole("dialog")).not.toBeInTheDocument();
+    expect(remove).not.toHaveBeenCalled();
+  });
+
+  it("requires confirmation before an edit is submitted", async () => {
+    const update = vi.spyOn(referralsApi, "update").mockResolvedValue({
+      ok: true,
+      status: 200,
+      data: { ...REFERRAL, therapyLeadStage: "SCHEDULED" },
+    });
+    await openReferral();
+
+    await userEvent.selectOptions(screen.getByLabelText("therapyLeadStage"), "SCHEDULED");
+    await userEvent.click(screen.getByRole("button", { name: "Save changes" }));
+
+    expect(update).not.toHaveBeenCalled();
+    const dialog = screen.getByRole("dialog");
+
+    await userEvent.click(within(dialog).getByRole("button", { name: "Save changes" }));
+    await waitFor(() =>
+      expect(update).toHaveBeenCalledWith(expect.anything(), "abc123", {
+        therapyLeadStage: "SCHEDULED",
+      }),
+    );
+  });
+
+  it("states on the edit form that edits are overwritten by the next Hex ingest", async () => {
+    await openReferral();
+
+    expect(screen.getByText(INGEST_OVERWRITE_WARNING)).toBeInTheDocument();
+    expect(INGEST_OVERWRITE_WARNING).toMatch(/overwritten by the next Hex ingest/i);
+  });
+
+  it("patches only the changed field, so editing a stage leaves mobile and email alone", async () => {
+    const update = vi.spyOn(referralsApi, "update").mockResolvedValue({
+      ok: true,
+      status: 200,
+      data: REFERRAL,
+    });
+    await openReferral();
+
+    await userEvent.selectOptions(screen.getByLabelText("psychLeadStage"), "PATIENT");
+    await userEvent.click(screen.getByRole("button", { name: "Save changes" }));
+    await userEvent.click(
+      within(screen.getByRole("dialog")).getByRole("button", { name: "Save changes" }),
+    );
+
+    await waitFor(() => expect(update).toHaveBeenCalled());
+    const body = update.mock.calls[0]?.[2];
+    expect(body).toEqual({ psychLeadStage: "PATIENT" });
+    expect(body).not.toHaveProperty("mobile");
+    expect(body).not.toHaveProperty("email");
+  });
+
+  it("sends null for an emptied optional field, distinguishing clear from omit", async () => {
+    const update = vi.spyOn(referralsApi, "update").mockResolvedValue({
+      ok: true,
+      status: 200,
+      data: REFERRAL,
+    });
+    await openReferral();
+
+    await userEvent.clear(screen.getByLabelText("mobile"));
+    await userEvent.click(screen.getByRole("button", { name: "Save changes" }));
+    await userEvent.click(
+      within(screen.getByRole("dialog")).getByRole("button", { name: "Save changes" }),
+    );
+
+    await waitFor(() => expect(update).toHaveBeenCalled());
+    expect(update.mock.calls[0]?.[2]).toEqual({ mobile: null });
+  });
+
+  it("persists no referral field to localStorage or sessionStorage", async () => {
+    const localSpy = vi.spyOn(Storage.prototype, "setItem");
+    await openReferral();
+
+    const persisted = localSpy.mock.calls.map(([key, value]) => `${key}=${value}`).join("|");
+    for (const phi of [REFERRAL.fullName, REFERRAL.mobile, REFERRAL.email, REFERRAL.leadId]) {
+      expect(persisted).not.toContain(phi);
+    }
+    expect(JSON.stringify(localStorage)).not.toContain("Jane Doe");
+    expect(JSON.stringify(sessionStorage)).not.toContain("Jane Doe");
+  });
+
+  it("does not offer unfiltered listing — the load button is disabled without a filter", async () => {
+    render(
+      <EnvironmentProvider>
+        <PcpReferrals />
+      </EnvironmentProvider>,
+    );
+
+    expect(screen.getByRole("button", { name: "Load referrals" })).toBeDisabled();
+  });
+});
diff --git a/apps/dev-dashboard/src/pages/PcpReferrals.tsx b/apps/dev-dashboard/src/pages/PcpReferrals.tsx
