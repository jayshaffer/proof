@@ -0,0 +1,42 @@
+import { evaluateGuards, resolveCohort } from "@attribution-service/practice-cohort";
+import type { components } from "../generated/internal-types";
+
+type CohortPreviewResponse = components["schemas"]["CohortPreviewResponse"];
+type CohortPreviewSkip = components["schemas"]["CohortPreviewSkip"];
+
+/**
+ * Resolves the cohort and evaluates the same guards the batch does, without any
+ * of its side effects: no PDF render, no ledger row, no S3 staging, no email,
+ * and no metric emission. resolveCohort is called without onPageFetched
+ * precisely so no batch counter moves.
+ *
+ * optOutVerified is always false: isPracticeOptedOut reads `optedOut`, which
+ * PracticeEntity does not declare (NEV-1412 closed Wont fix), so OPTED_OUT is
+ * unreachable and the preview must not imply otherwise.
+ */
+export async function getCohortPreview(): Promise<CohortPreviewResponse> {
+  const cohort = await resolveCohort();
+
+  const skipped: CohortPreviewSkip[] = [];
+  let proceedCount = 0;
+
+  for (const practice of cohort.practices) {
+    const decision = evaluateGuards(practice);
+    if (decision.decision === "SKIP") {
+      skipped.push({
+        practiceId: practice.id,
+        practiceName: practice.name,
+        reason: decision.reason,
+      });
+      continue;
+    }
+    proceedCount++;
+  }
+
+  return {
+    cohortSize: cohort.size,
+    proceedCount,
+    skipped,
+    optOutVerified: false,
+  };
+}
