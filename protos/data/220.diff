@@ -0,0 +1,31 @@
+import { type Practice, PracticeStatus, practiceRepository } from "@attribution-service/data";
+import type { Cohort, ResolveCohortOptions } from "./types";
+
+const DEFAULT_PAGE_SIZE = 100;
+
+/**
+ * Selects every SOLD practice, paginating to completion.
+ *
+ * Metric emission is the caller's concern: batch-runner passes onPageFetched
+ * and emits its own size gauge, while the dashboard preview passes neither so
+ * a read-only preview cannot move a batch counter.
+ */
+export const resolveCohort = async ({
+  pageSize = DEFAULT_PAGE_SIZE,
+  onPageFetched,
+}: ResolveCohortOptions = {}): Promise<Cohort> => {
+  const practices: Practice[] = [];
+  let cursor: string | undefined;
+  do {
+    const page = await practiceRepository.listPracticesByStatus(
+      PracticeStatus.SOLD,
+      pageSize,
+      cursor,
+    );
+    practices.push(...page.practices);
+    onPageFetched?.();
+    cursor = page.nextCursor;
+  } while (cursor !== undefined);
+
+  return { practices, size: practices.length };
+};
