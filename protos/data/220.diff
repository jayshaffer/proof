+import type { Practice } from "@attribution-service/data";
+import type { SkipReason } from "./skip-reason";
+
+export type PracticeWithGuardFields = Practice & {
+  optedOut?: boolean;
+};
+
+export type GuardDecision = { decision: "PROCEED" } | { decision: "SKIP"; reason: SkipReason };
+
+export interface ResolveCohortOptions {
+  pageSize?: number;
+  /**
+   * Invoked once per fetched page. The batch uses it to emit its page counter;
+   * the preview omits it so a read-only preview moves no batch metric.
+   */
+  onPageFetched?: () => void;
+}
+
+export interface Cohort {
+  practices: Practice[];
+  size: number;
+}
