diff --git a/apps/api/src/__tests__/routes/internal-cohort-preview.test.ts b/apps/api/src/__tests__/routes/internal-cohort-preview.test.ts
new file mode 100644
index 00000000..7ead368e
--- /dev/null
+++ b/apps/api/src/__tests__/routes/internal-cohort-preview.test.ts
@@ -0,0 +1,145 @@
+import { clearAllItems, practiceRepository } from "@attribution-service/data";
+import { afterEach, describe, expect, test, vi } from "vitest";
+import { stats } from "../../components";
+import { useServerHelper } from "../util";
+
+vi.mock("../../config");
+
+const AUTH_HEADER = { authorization: "Bearer valid-test-key" };
+
+const seedPractice = (
+  id: string,
+  overrides: { status?: "SOLD" | "CHURNED"; practiceEmail?: string } = {},
+) =>
+  practiceRepository.upsertPractice({
+    id,
+    name: `Practice ${id}`,
+    status: overrides.status ?? "SOLD",
+    accountManager: "Jordan Lee",
+    ...(overrides.practiceEmail !== undefined && { practiceEmail: overrides.practiceEmail }),
+  });
+
+describe("GET /internal/practice-reports/cohort-preview", () => {
+  const serverHelper = useServerHelper();
+
+  afterEach(async () => {
+    await clearAllItems();
+  });
+
+  const preview = () =>
+    serverHelper.getServer().inject({
+      method: "GET",
+      url: "/internal/practice-reports/cohort-preview",
+      headers: AUTH_HEADER,
+    });
+
+  test("selects only SOLD practices", async () => {
+    await seedPractice("SOLD-1", { practiceEmail: "a@example.com" });
+    await seedPractice("CHURNED-1", { status: "CHURNED", practiceEmail: "b@example.com" });
+
+    const body = (await preview()).json();
+
+    expect(body.cohortSize).toBe(1);
+    expect(body.proceedCount).toBe(1);
+  });
+
+  test("reports a practice without practiceEmail as skipped NO_PRACTICE_CONTACT_EMAIL", async () => {
+    await seedPractice("NO-EMAIL");
+
+    const body = (await preview()).json();
+
+    expect(body.skipped).toEqual([
+      {
+        practiceId: "NO-EMAIL",
+        practiceName: "Practice NO-EMAIL",
+        reason: "NO_PRACTICE_CONTACT_EMAIL",
+      },
+    ]);
+    expect(body.proceedCount).toBe(0);
+  });
+
+  test("treats a whitespace-only practiceEmail as absent", async () => {
+    await seedPractice("BLANK-EMAIL", { practiceEmail: "   " });
+
+    const body = (await preview()).json();
+
+    expect(body.skipped[0].reason).toBe("NO_PRACTICE_CONTACT_EMAIL");
+  });
+
+  test("reports a practice with a valid email as proceeding", async () => {
+    await seedPractice("GOOD-1", { practiceEmail: "front-desk@example.com" });
+
+    const body = (await preview()).json();
+
+    expect(body.proceedCount).toBe(1);
+    expect(body.skipped).toEqual([]);
+  });
+
+  test("carries cohort size, proceed count, and the skip list together", async () => {
+    await seedPractice("GOOD-1", { practiceEmail: "a@example.com" });
+    await seedPractice("GOOD-2", { practiceEmail: "b@example.com" });
+    await seedPractice("BAD-1");
+
+    const res = await preview();
+
+    expect(res.statusCode).toBe(200);
+    expect(res.json()).toMatchObject({
+      cohortSize: 3,
+      proceedCount: 2,
+      optOutVerified: false,
+    });
+    expect(res.json().skipped).toHaveLength(1);
+  });
+
+  test("emits no Datadog counter or gauge — a preview must not move batch metrics", async () => {
+    await seedPractice("GOOD-1", { practiceEmail: "a@example.com" });
+    await seedPractice("BAD-1");
+    const counterSpy = vi.spyOn(stats, "sendCounter").mockResolvedValue(undefined);
+    const gaugeSpy = vi.spyOn(stats, "sendGauge").mockResolvedValue(undefined);
+
+    try {
+      const res = await preview();
+      expect(res.statusCode).toBe(200);
+
+      const batchCalls = [...counterSpy.mock.calls, ...gaugeSpy.mock.calls].filter(([metric]) =>
+        String(metric).startsWith("batch."),
+      );
+      expect(batchCalls).toEqual([]);
+    } finally {
+      counterSpy.mockRestore();
+      gaugeSpy.mockRestore();
+    }
+  });
+
+  test("writes no PracticeReportPublished ledger row", async () => {
+    await seedPractice("GOOD-1", { practiceEmail: "a@example.com" });
+
+    await preview();
+
+    // A published row would appear as a new item beyond the seeded practice.
+    const practices = await practiceRepository.listPractices(100);
+    expect(practices.practices.map((p) => p.id)).toEqual(["GOOD-1"]);
+  });
+
+  test("reports OPTED_OUT for zero practices and surfaces the unverified caveat", async () => {
+    await seedPractice("GOOD-1", { practiceEmail: "a@example.com" });
+    await seedPractice("BAD-1");
+
+    const body = (await preview()).json();
+
+    expect(body.skipped.filter((s: { reason: string }) => s.reason === "OPTED_OUT")).toEqual([]);
+    expect(body.optOutVerified).toBe(false);
+  });
+
+  test("enumerates a cohort spanning multiple pages", async () => {
+    // resolveCohort pages at 100, so this must exceed one page to prove the
+    // preview covers the whole cohort rather than just the first page.
+    const ids = Array.from({ length: 105 }, (_, i) => `P-${String(i).padStart(3, "0")}`);
+    await Promise.all(ids.map((id) => seedPractice(id, { practiceEmail: `${id}@example.com` })));
+
+    const body = (await preview()).json();
+
+    expect(body.cohortSize).toBe(105);
+    expect(body.proceedCount).toBe(105);
+  });
+});
