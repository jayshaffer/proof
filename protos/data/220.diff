@@ -0,0 +1,78 @@
+import { clearAllItems, PracticeStatus, practiceRepository } from "@attribution-service/data";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { resolveCohort } from "../cohort";
+
+const seedPractices = async (count: number, status: PracticeStatus) => {
+  const paddingWidth = String(count).length;
+  await Promise.all(
+    Array.from({ length: count }, (_, i) => {
+      const id = `ACCT-${String(i + 1).padStart(paddingWidth, "0")}`;
+      return practiceRepository.upsertPractice({
+        id,
+        name: `Practice ${id}`,
+        status,
+        accountManager: "Test Manager",
+      });
+    }),
+  );
+};
+
+describe("resolveCohort", () => {
+  afterEach(async () => {
+    await clearAllItems();
+  });
+
+  it("returns every SOLD practice exactly once when paginating GSI reads", async () => {
+    await seedPractices(50, PracticeStatus.SOLD);
+
+    const cohort = await resolveCohort({ pageSize: 10 });
+
+    expect(cohort.size).toBe(50);
+    expect(new Set(cohort.practices.map((p) => p.id)).size).toBe(50);
+  });
+
+  it("excludes non-SOLD practices from the cohort", async () => {
+    await seedPractices(5, PracticeStatus.SOLD);
+    await practiceRepository.upsertPractice({
+      id: "CHURN-1",
+      name: "Churned Practice",
+      status: PracticeStatus.CHURNED,
+      accountManager: "Test",
+    });
+
+    const cohort = await resolveCohort({ pageSize: 10 });
+
+    expect(cohort.size).toBe(5);
+    expect(cohort.practices.map((p) => p.id)).not.toContain("CHURN-1");
+  });
+
+  it("serves the cohort from the status GSI rather than a table scan", async () => {
+    await seedPractices(3, PracticeStatus.SOLD);
+    const listSpy = vi.spyOn(practiceRepository, "listPracticesByStatus");
+
+    await resolveCohort({ pageSize: 2 });
+
+    expect(listSpy).toHaveBeenCalled();
+    for (const call of listSpy.mock.calls) {
+      expect(call[0]).toBe(PracticeStatus.SOLD);
+    }
+    listSpy.mockRestore();
+  });
+
+  it("invokes onPageFetched once per page so the caller owns metric emission", async () => {
+    await seedPractices(50, PracticeStatus.SOLD);
+    const onPageFetched = vi.fn();
+
+    await resolveCohort({ pageSize: 10, onPageFetched });
+
+    expect(onPageFetched.mock.calls.length).toBeGreaterThanOrEqual(5);
+  });
+
+  it("resolves without a callback, so a read-only caller emits nothing", async () => {
+    await seedPractices(4, PracticeStatus.SOLD);
+
+    const cohort = await resolveCohort({ pageSize: 2 });
+
+    expect(cohort.size).toBe(4);
+  });
+});
