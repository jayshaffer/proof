+import type { Practice } from "@attribution-service/data";
+import { SkipReason } from "./skip-reason";
+import type { GuardDecision, PracticeWithGuardFields } from "./types";
+
+export const hasPracticeContactEmail = (practice: Practice): boolean => {
+  return practice.practiceEmail != null && practice.practiceEmail.trim().length > 0;
+};
+
+// Local stub until NEV-1412 lands the real predicate; consumed via import so
+// the drop-in swap is a one-line change.
+// TODO(NEV-1412): replace with imported predicate from opt-out module.
+export const isPracticeOptedOut = (practice: Practice): boolean => {
+  return (practice as PracticeWithGuardFields).optedOut === true;
+};
+
+export const evaluateGuards = (practice: Practice): GuardDecision => {
+  if (isPracticeOptedOut(practice)) {
+    return { decision: "SKIP", reason: SkipReason.OPTED_OUT };
+  }
+  if (!hasPracticeContactEmail(practice)) {
+    return { decision: "SKIP", reason: SkipReason.NO_PRACTICE_CONTACT_EMAIL };
+  }
+  return { decision: "PROCEED" };
+};
